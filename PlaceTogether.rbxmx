local function setNotice(message)
	local str = tostring(message or "")
	local nl = str:find(string.char(10), 1, true)
	local line = nl and str:sub(1, nl - 1) or str
	if line:sub(-1) == string.char(13) then
		line = line:sub(1, -2)
	end
	notice.Text = line
end

-- ============================================================
-- CORE SYNC ENGINE & EVENT-DRIVEN DIRTY TRACKER
-- ============================================================
local currentActiveScriptInfo = nil
local active = false
local busy = false
local restoreSuppressed = false
local applyingRemote = false
local smoothLerpEnabled = plugin:GetSetting("PTSmoothLerp") ~= false

local objects = {}         -- key -> Instance
local ids = {}             -- Instance -> key
local baseline = {}        -- key -> last synced captured record
local cachedSnapshot = {}  -- key -> latest local captured record
local versions = {}        -- key -> revision int
local dirtyKeys = {}       -- key -> true
local objConnections = {}  -- Instance -> { RBXScriptConnection, ... }
local rootConnections = {} -- { RBXScriptConnection, ... }
local verifyOrder = {}     -- array of keys for lightweight rolling check
local verifyCursor = 1

local dirtyTerrainChunks = {}
local endpoint, credential
local currentRevision = 0
local lastKnownObjectCount = 0
local lastSaveTimestamp = 0

local propertyCache = {}
local pending = {}
local meshRetry = {}
local referenceRetry = {}
local appearanceRetry = {}
local warnings = {}

-- Smooth 60FPS CFrame interpolation state for remote moving objects
local smoothTargets = {} -- key -> { obj = Instance, targetCF = CFrame, isModel = boolean, updatedAt = number }

local function status(s)
	setNotice(s)
end

local function warn(key, message)
	warnings[key] = message
end

local function warningText()
	local count = 0
	local sample = {}
	for _, message in pairs(warnings) do
		count += 1
		if #sample < 2 then
			table.insert(sample, message)
		end
	end
	return count > 0 and (string.char(10).."Limitations ("..count.."): "..table.concat(sample, "; ")) or ""
end

local function refreshUI(isActive, isLoggedIn, hasInbox, isBusy)
	homePanel.Visible = (uiTab == "home")
	savesPanel.Visible = (uiTab == "saves")
	settingsPanel.Visible = (uiTab == "settings")

	if shareNick.Text ~= selfNick.Text then
		shareNick.Text = selfNick.Text
	end
	identity.Text = isLoggedIn and (selfNick.Text..(isActive and " · Live Sync (6.6Hz)" or " · Connected")) or "Connecting to server..."

	if isActive then
		dot.BackgroundColor3 = palette.green
		statusBadgeLabel.Text = "LIVE"
		statusBadgeLabel.TextColor3 = palette.green
		badgeStroke.Color = palette.green
	elseif isLoggedIn then
		dot.BackgroundColor3 = palette.accent
		statusBadgeLabel.Text = "READY"
		statusBadgeLabel.TextColor3 = palette.accent
		badgeStroke.Color = palette.line
	else
		dot.BackgroundColor3 = palette.muted
		statusBadgeLabel.Text = "OFFLINE"
		statusBadgeLabel.TextColor3 = palette.muted
		badgeStroke.Color = palette.line
	end

	sessionCard.Visible = isActive
	connect.Visible = isActive
	hostStartBtn.Visible = isLoggedIn and not isActive
	incomingCard.Visible = hasInbox
	retry.Visible = isLoggedIn and not isActive and room.Text ~= ""

	for key, b in pairs(tabButtons) do
		local isSelected = (uiTab == key)
		b.BackgroundColor3 = isSelected and palette.tabActive or palette.tabBg
		b.TextColor3 = isSelected and palette.text or palette.muted
		b.Font = isSelected and Enum.Font.GothamBold or Enum.Font.GothamMedium
		if tabStrokes[key] then
			tabStrokes[key].Enabled = isSelected
			tabStrokes[key].Color = isSelected and palette.cardBorder or palette.line
		end
	end

	for _, b in ipairs({invite, yes, no, connect, retry, accept, logout, hostStartBtn, quickSaveBtn, createSnapBtn}) do
		b.Active = not isBusy
		b.AutoButtonColor = not isBusy
		b.TextTransparency = isBusy and 0.45 or 0
	end
end

button.Click:Connect(function()
	widget.Enabled = not widget.Enabled
end)

smoothToggle.Text = smoothLerpEnabled and "Smooth 60FPS Part Lerp: On" or "Smooth 60FPS Part Lerp: Off"
smoothToggle.MouseButton1Click:Connect(function()
	smoothLerpEnabled = not smoothLerpEnabled
	plugin:SetSetting("PTSmoothLerp", smoothLerpEnabled)
	smoothToggle.Text = smoothLerpEnabled and "Smooth 60FPS Part Lerp: On" or "Smooth 60FPS Part Lerp: Off"
	if not smoothLerpEnabled then
		smoothTargets = {}
	end
end)

local function equal(a, b)
	if a == b then return true end
	local ta, tb = type(a), type(b)
	if ta ~= tb then return false end
	if ta == "number" then
		if a ~= a or b ~= b then return a == b end
		return math.abs(a - b) < 0.004
	end
	if ta ~= "table" then return false end
	for k, v in pairs(a) do
		if not equal(v, b[k]) then return false end
	end
	for k in pairs(b) do
		if a[k] == nil then return false end
	end
	return true
end

local function copy(value)
	if type(value) ~= "table" then return value end
	local result = {}
	for key, item in pairs(value) do
		result[key] = copy(item)
	end
	return result
end

-- ============================================================
-- REAL-TIME COLLABORATIVE SCRIPT MERGE ENGINE (3-WAY MERGE)
-- ============================================================
local function splitLines(text)
	local lines = {}
	if not text or text == "" then return lines end
	local clean = text:gsub(string.char(13, 10), string.char(10)):gsub(string.char(13), string.char(10))
	local pos = 1
	local len = #clean
	while pos <= len do
		local nl = clean:find(string.char(10), pos, true)
		if nl then
			table.insert(lines, clean:sub(pos, nl - 1))
			pos = nl + 1
		else
			table.insert(lines, clean:sub(pos))
			break
		end
	end
	if clean:sub(-1) == string.char(10) then
		table.insert(lines, "")
	end
	return lines
end

local function lcsMatch(a, b)
	local n, m = #a, #b
	local pref = 0
	while pref < n and pref < m and a[pref + 1] == b[pref + 1] do
		pref = pref + 1
	end

	local suf = 0
	while suf < (n - pref) and suf < (m - pref) and a[n - suf] == b[m - suf] do
		suf = suf + 1
	end

	local midA_len = n - pref - suf
	local midB_len = m - pref - suf
	local pairs = {}
	local matchedA = {}
	local matchedB = {}

	for k = 1, pref do
		pairs[k] = k
		matchedA[k] = true
		matchedB[k] = true
	end
	for k = 0, suf - 1 do
		local aIdx = n - k
		local bIdx = m - k
		pairs[aIdx] = bIdx
		matchedA[aIdx] = true
		matchedB[bIdx] = true
	end

	if midA_len > 0 and midB_len > 0 then
		local dp = {}
		for i = 0, midA_len do
			dp[i] = {}
			for j = 0, midB_len do
				dp[i][j] = 0
			end
		end

		for i = 1, midA_len do
			local lineA = a[pref + i]
			for j = 1, midB_len do
				if lineA == b[pref + j] then
					dp[i][j] = dp[i - 1][j - 1] + 1
				else
					local v1 = dp[i - 1][j]
					local v2 = dp[i][j - 1]
					dp[i][j] = (v1 > v2) and v1 or v2
				end
			end
		end

		local i, j = midA_len, midB_len
		while i > 0 and j > 0 do
			if a[pref + i] == b[pref + j] then
				local aIdx = pref + i
				local bIdx = pref + j
				pairs[aIdx] = bIdx
				matchedA[aIdx] = true
				matchedB[bIdx] = true
				i = i - 1
				j = j - 1
			elseif dp[i - 1][j] >= dp[i][j - 1] then
				i = i - 1
			else
				j = j - 1
			end
		end
	end

	return pairs, matchedA, matchedB
end

local function analyzeDiff(baseLines, modLines)
	local pairs, matchedBase, matchedMod = lcsMatch(baseLines, modLines)
	local n = #baseLines
	local m = #modLines
	local insertsBefore = {}
	for i = 1, n + 1 do
		insertsBefore[i] = {}
	end

	local curBase = 1
	for j = 1, m do
		if matchedMod[j] then
			for aIdx, bIdx in pairs(pairs) do
				if bIdx == j then
					curBase = aIdx + 1
					break
				end
			end
		else
			local target = (curBase <= n) and curBase or (n + 1)
			table.insert(insertsBefore[target], modLines[j])
		end
	end

	local stateOf = {}
	for i = 1, n do
		stateOf[i] = matchedBase[i] and "equal" or "deleted"
	end

	return insertsBefore, stateOf
end

local function merge3WayText(baseStr, localStr, remoteStr)
	if localStr == baseStr then
		return remoteStr, (remoteStr ~= baseStr)
	end
	if remoteStr == baseStr or localStr == remoteStr then
		return localStr, false
	end

	local base = splitLines(baseStr)
	local localLines = splitLines(localStr)
	local remoteLines = splitLines(remoteStr)

	local insLoc, stateLoc = analyzeDiff(base, localLines)
	local insRem, stateRem = analyzeDiff(base, remoteLines)

	local result = {}
	local n = #base

	local function appendLines(lines)
		for _, l in ipairs(lines) do
			table.insert(result, l)
		end
	end

	local function sameLines(a, b)
		if #a ~= #b then return false end
		for k = 1, #a do
			if a[k] ~= b[k] then return false end
		end
		return true
	end

	for i = 1, n + 1 do
		local locIn = insLoc[i] or {}
		local remIn = insRem[i] or {}

		if #locIn > 0 and #remIn == 0 then
			appendLines(locIn)
		elseif #remIn > 0 and #locIn == 0 then
			appendLines(remIn)
		elseif #locIn > 0 and #remIn > 0 then
			if sameLines(locIn, remIn) then
				appendLines(locIn)
			else
				appendLines(remIn)
				appendLines(locIn)
			end
		end

		if i <= n then
			local stL = stateLoc[i]
			local stR = stateRem[i]
			if stL == "deleted" and stR == "deleted" then
				-- Both deleted
			elseif stL == "deleted" and stR == "equal" then
				-- Local deleted
			elseif stR == "deleted" and stL == "equal" then
				-- Remote deleted
			else
				-- Neither deleted
				table.insert(result, base[i])
			end
		end
	end

	return table.concat(result, "\n"), true
end

local function merge(base, localValue, remote, keyName)
	if keyName == "Source" and (type(localValue) == "string" or type(remote) == "string") then
		local bStr = (type(base) == "string") and base or ""
		local lStr = (type(localValue) == "string") and localValue or ""
		local rStr = (type(remote) == "string") and remote or ""
		return merge3WayText(bStr, lStr, rStr)
	end
	if equal(localValue, base) then return copy(remote) end
	if equal(remote, base) or equal(localValue, remote) then return copy(localValue) end
	if type(localValue) ~= "table" or type(remote) ~= "table" or localValue.t or remote.t then return copy(localValue) end
	if localValue.class == nil and localValue.props == nil and #localValue > 0 then return copy(localValue) end
	local result = {}
	local keys = {}
	for key in pairs(localValue) do keys[key] = true end
	for key in pairs(remote) do keys[key] = true end
	if type(base) == "table" then
		for key in pairs(base) do keys[key] = true end
	end
	for key in pairs(keys) do
		local previous = (type(base) == "table") and base[key] or nil
		result[key] = merge(previous, localValue[key], remote[key], key)
	end
	return result
end

local function acknowledged(remote, desired, actual)
	if equal(remote, desired) then return copy(actual) end
	if type(remote) ~= "table" or type(desired) ~= "table" or type(actual) ~= "table" then return copy(remote) end
	local result = {}
	local keys = {}
	for key in pairs(remote) do keys[key] = true end
	for key in pairs(desired) do keys[key] = true end
	for key in pairs(actual) do keys[key] = true end
	for key in pairs(keys) do
		result[key] = acknowledged(remote[key], desired[key], actual[key])
	end
	return result
end

-- ============================================================
-- TERRAIN ENGINE (FIXED INFINITE VOXEL SCAN BUG)
-- ============================================================
local terrainCache = {}
local terrainKnown = {}
local terrainScanned = {} -- Prevents re-reading empty air chunks around camera every tick!
local CHUNK, VOXELS = 64, 16

local function terrainKey(x, y, z)
	return "~Terrain/"..x.."/"..y.."/"..z
end

local function terrainRegion(origin)
	return Region3.new(
		Vector3.new(origin[1], origin[2], origin[3]),
		Vector3.new(origin[1] + CHUNK, origin[2] + CHUNK, origin[3] + CHUNK)
	)
end

local function readTerrain(origin)
	local channels = workspace.Terrain:ReadVoxelChannels(
		terrainRegion(origin),
		4,
		{"SolidMaterial", "SolidOccupancy", "LiquidOccupancy"}
	)
	local runs = {}
	local previous
	local nonempty = false
	for x = 1, VOXELS do
		for y = 1, VOXELS do
			for z = 1, VOXELS do
				local material = channels.SolidMaterial[x][y][z].Name
				local solid, liquid = channels.SolidOccupancy[x][y][z], channels.LiquidOccupancy[x][y][z]
				if solid > 0 or liquid > 0 then
					nonempty = true
				end
				if previous and previous[1] == material and previous[2] == solid and previous[3] == liquid then
					previous[4] += 1
				else
					previous = {material, solid, liquid, 1}
					table.insert(runs, previous)
				end
			end
		end
	end
	if not nonempty then return nil end
	return {
		class = "PTTerrainChunk",
		name = "Terrain chunk",
		parent = "@Workspace",
		props = {origin = origin, runs = runs}
	}
end

local function writeTerrain(origin, runs)
	local channels = {SolidMaterial = {}, SolidOccupancy = {}, LiquidOccupancy = {}}
	local runIndex, remaining = 1, runs[1] and runs[1][4] or 0
	local written = 0
	for x = 1, VOXELS do
		for _, array in pairs(channels) do array[x] = {} end
		for y = 1, VOXELS do
			for _, array in pairs(channels) do array[x][y] = {} end
			for z = 1, VOXELS do
				while remaining == 0 and runIndex < #runs do
					runIndex += 1
					remaining = runs[runIndex][4]
				end
				local run = runs[runIndex]
				if not run or remaining < 1 then error("Corrupted Terrain packet") end
				local material = Enum.Material[run[1]]
				if not material then error("Unknown Terrain material") end
				channels.SolidMaterial[x][y][z] = material
				channels.SolidOccupancy[x][y][z] = run[2]
				channels.LiquidOccupancy[x][y][z] = run[3]
				remaining -= 1
				written += 1
			end
		end
	end
	if written ~= 4096 or runIndex ~= #runs or remaining ~= 0 then
		error("Invalid Terrain packet size")
	end
	workspace.Terrain:WriteVoxelChannels(terrainRegion(origin), 4, channels)
end

local function terrainReset()
	terrainCache = {}
	terrainKnown = {}
	terrainScanned = {}
	dirtyTerrainChunks = {}
end

pcall(function()
	workspace.Terrain.TerrainModified:Connect(function(region)
		if applyingRemote then return end
		pcall(function()
			local minV = region.Min
			local maxV = region.Max
			local x0 = math.floor((minV.X * 4) / CHUNK) * CHUNK
			local x1 = math.floor((maxV.X * 4) / CHUNK) * CHUNK
			local y0 = math.floor((minV.Y * 4) / CHUNK) * CHUNK
			local y1 = math.floor((maxV.Y * 4) / CHUNK) * CHUNK
			local z0 = math.floor((minV.Z * 4) / CHUNK) * CHUNK
			local z1 = math.floor((maxV.Z * 4) / CHUNK) * CHUNK
			for x = x0, x1, CHUNK do
				for y = y0, y1, CHUNK do
					for z = z0, z1, CHUNK do
						local key = terrainKey(x, y, z)
						dirtyTerrainChunks[key] = {x, y, z}
					end
				end
			end
		end)
	end)
end)

local function terrainRecords()
	-- Incrementally discover un-scanned chunks around camera (max 6 per tick to keep frame time < 0.5ms)
	pcall(function()
		local cam = workspace.CurrentCamera
		if cam and cam.Focus then
			local p = cam.Focus.Position
			local cx = math.floor(p.X / CHUNK) * CHUNK
			local cy = math.floor(p.Y / CHUNK) * CHUNK
			local cz = math.floor(p.Z / CHUNK) * CHUNK
			local radius = CHUNK
			local added = 0
			for x = cx - radius, cx + radius, CHUNK do
				for y = cy - radius, cy + radius, CHUNK do
					for z = cz - radius, cz + radius, CHUNK do
						local key = terrainKey(x, y, z)
						if not terrainScanned[key] then
							terrainScanned[key] = true
							dirtyTerrainChunks[key] = {x, y, z}
							added += 1
							if added >= 6 then return end
						end
					end
				end
			end
		end
	end)

	if next(dirtyTerrainChunks) then
		local processed = 0
		for key, origin in pairs(dirtyTerrainChunks) do
			local ok, value = pcall(readTerrain, origin)
			if ok then
				terrainCache[key] = value
				if value or terrainKnown[key] then
					terrainKnown[key] = origin
				end
				cachedSnapshot[key] = value
			end
			dirtyTerrainChunks[key] = nil
			processed += 1
			if processed >= 8 then break end
		end
	end
	return terrainCache
end

local function applyTerrain(key, value)
	local origin = value and value.props and value.props.origin or terrainKnown[key]
	if not origin then return end
	applyingRemote = true
	local ok, err = pcall(function()
		if #origin ~= 3 then error("Invalid Terrain position") end
		writeTerrain(origin, value and value.props.runs or {{"Air", 0, 0, 4096}})
	end)
	applyingRemote = false
	if ok then
		terrainKnown[key] = origin
		terrainScanned[key] = true
		terrainCache[key] = copy(value)
		cachedSnapshot[key] = copy(value)
		warnings[key..":terrain"] = nil
	else
		warn(key..":terrain", "Terrain: "..tostring(err))
	end
end

-- ============================================================
-- SERIALIZATION & PROPERTY REFLECTION
-- ============================================================
local function encode(v)
	local t = typeof(v)
	if t == "nil" then return {t = "Nil"} end
	if t == "string" or t == "boolean" then return v end
	if t == "number" then
		if v == v and math.abs(v) < math.huge then return v end
		return nil
	end
	if t == "Vector3" or t == "Vector3int16" then return {t = t, v = {v.X, v.Y, v.Z}} end
	if t == "Vector2" or t == "Vector2int16" then return {t = t, v = {v.X, v.Y}} end
	if t == "Color3" then return {t = t, v = {v.R, v.G, v.B}} end
	if t == "CFrame" then return {t = t, v = {v:GetComponents()}} end
	if t == "UDim2" then return {t = t, v = {v.X.Scale, v.X.Offset, v.Y.Scale, v.Y.Offset}} end
	if t == "UDim" then return {t = t, v = {v.Scale, v.Offset}} end
	if t == "BrickColor" then return {t = t, v = v.Number} end
	if t == "NumberRange" then return {t = t, v = {v.Min, v.Max}} end
	if t == "Rect" then return {t = t, v = {v.Min.X, v.Min.Y, v.Max.X, v.Max.Y}} end
	if t == "NumberSequence" then
		local a = {}
		for _, k in ipairs(v.Keypoints) do table.insert(a, {k.Time, k.Value, k.Envelope}) end
		return {t = t, v = a}
	end
	if t == "ColorSequence" then
		local a = {}
		for _, k in ipairs(v.Keypoints) do table.insert(a, {k.Time, k.Value.R, k.Value.G, k.Value.B}) end
		return {t = t, v = a}
	end
	if t == "PhysicalProperties" then return {t = t, v = {v.Density, v.Friction, v.Elasticity, v.FrictionWeight, v.ElasticityWeight}} end
	if t == "Font" then return {t = t, v = {v.Family, v.Weight.Name, v.Style.Name}} end
	if t == "Ray" then return {t = t, o = encode(v.Origin), d = encode(v.Direction)} end
	if t == "Axes" then return {t = t, v = {v.X, v.Y, v.Z}} end
	if t == "Faces" then return {t = t, v = {v.Top, v.Bottom, v.Left, v.Right, v.Front, v.Back}} end
	if t == "EnumItem" then return {t = t, e = tostring(v.EnumType):gsub("^Enum%.", ""), v = v.Name} end
	if t == "Instance" then
		if ids[v] then return {t = t, v = ids[v]} end
		if v.Parent == game then return {t = "Service", v = v.ClassName} end
		if v == workspace.Terrain then return {t = "Terrain"} end
		if v == workspace.CurrentCamera then return {t = "CurrentCamera"} end
		return nil
	end
	if t == "Content" then
		if v.SourceType == Enum.ContentSourceType.None then return {t = t, v = ""} end
		if v.SourceType == Enum.ContentSourceType.Uri then return {t = t, v = v.Uri} end
		return nil
	end
	return nil
end

local function decode(v)
	if type(v) ~= "table" then return v end
	local t = v.t
	if t == "Nil" then return nil end
	if t == "Vector3" then return Vector3.new(table.unpack(v.v)) end
	if t == "Vector3int16" then return Vector3int16.new(table.unpack(v.v)) end
	if t == "Vector2" then return Vector2.new(table.unpack(v.v)) end
	if t == "Vector2int16" then return Vector2int16.new(table.unpack(v.v)) end
	if t == "Color3" then return Color3.new(table.unpack(v.v)) end
	if t == "CFrame" then return CFrame.new(table.unpack(v.v)) end
	if t == "UDim2" then return UDim2.new(table.unpack(v.v)) end
	if t == "UDim" then return UDim.new(table.unpack(v.v)) end
	if t == "BrickColor" then return BrickColor.new(v.v) end
	if t == "NumberRange" then return NumberRange.new(table.unpack(v.v)) end
	if t == "Rect" then return Rect.new(table.unpack(v.v)) end
	if t == "NumberSequence" then
		local a = {}
		for _, k in ipairs(v.v) do table.insert(a, NumberSequenceKeypoint.new(table.unpack(k))) end
		return NumberSequence.new(a)
	end
	if t == "ColorSequence" then
		local a = {}
		for _, k in ipairs(v.v) do table.insert(a, ColorSequenceKeypoint.new(k[1], Color3.new(k[2], k[3], k[4]))) end
		return ColorSequence.new(a)
	end
	if t == "PhysicalProperties" then return PhysicalProperties.new(table.unpack(v.v)) end
	if t == "Font" then return Font.new(v.v[1], Enum.FontWeight[v.v[2]], Enum.FontStyle[v.v[3]]) end
	if t == "Ray" then return Ray.new(decode(v.o), decode(v.d)) end
	if t == "Axes" then
		local a = {}
		for i, b in ipairs(v.v) do
			if b then table.insert(a, ({Enum.Axis.X, Enum.Axis.Y, Enum.Axis.Z})[i]) end
		end
		return Axes.new(table.unpack(a))
	end
	if t == "Faces" then
		local a = {}
		for i, b in ipairs(v.v) do
			if b then table.insert(a, ({Enum.NormalId.Top, Enum.NormalId.Bottom, Enum.NormalId.Left, Enum.NormalId.Right, Enum.NormalId.Front, Enum.NormalId.Back})[i]) end
		end
		return Faces.new(table.unpack(a))
	end
	if t == "EnumItem" then return Enum[v.e][v.v] end
	if t == "Instance" then return objects[v.v] end
	if t == "Service" then return game:GetService(v.v) end
	if t == "Terrain" then return workspace.Terrain end
	if t == "CurrentCamera" then return workspace.CurrentCamera end
	if t == "Content" then return v.v == "" and Content.none or Content.fromUri(v.v) end
	error("Unknown type "..tostring(t))
end

local denied = {
	Name = true, Parent = true, ClassName = true, Source = true,
	UniqueId = true, HistoryId = true, Capabilities = true,
	Sandboxed = true, DefinesCapabilities = true, RobloxLocked = true,
	Tags = true, Attributes = true, AttributesSerialize = true, AttributesReplicate = true
}
local physics = {
	AssemblyLinearVelocity = true, AssemblyAngularVelocity = true,
	Velocity = true, RotVelocity = true, ReceiveAge = true
}
local publicEdit = {
	Size = true, Color = true, Shape = true, MaterialVariant = true,
	Archivable = true, WorldPivot = true, ImageContent = true,
	AudioContent = true, MeshContent = true, TextureContent = true,
	ColorMapContent = true, CameraOffset = true, Health = true,
	Axis = true, SecondaryAxis = true
}
local appearanceProps = {
	"Image", "ImageContent", "ImageColor3", "ImageTransparency",
	"ImageRectOffset", "ImageRectSize", "ScaleType", "SliceCenter",
	"SliceScale", "TileSize", "ResampleMode", "Texture", "TextureContent",
	"TextureID", "ColorMap", "ColorMapContent", "NormalMap", "NormalMapContent",
	"RoughnessMap", "RoughnessMapContent", "MetalnessMap", "MetalnessMapContent",
	"EmissiveMaskContent", "EmissiveStrength", "EmissiveTint", "AlphaMode",
	"Color", "Transparency", "Face", "StudsPerTileU", "StudsPerTileV",
	"OffsetStudsU", "OffsetStudsV"
}
local appearanceSet = {}
for _, name in ipairs(appearanceProps) do
	appearanceSet[name] = true
end
local contentAliases = {
	Image = "ImageContent", Texture = "TextureContent",
	ColorMap = "ColorMapContent", NormalMap = "NormalMapContent",
	RoughnessMap = "RoughnessMapContent", MetalnessMap = "MetalnessMapContent"
}

-- Zero-allocation property reader helper
local function rawGetProp(obj, prop)
	return obj[prop]
end

local function properties(obj)
	local class = obj.ClassName
	if propertyCache[class] then
		return propertyCache[class]
	end
	local list = {}
	local seen = {}
	local function add(name)
		if not seen[name] and not denied[name] and not physics[name] then
			local modern = contentAliases[name]
			if modern then
				local readable, value = pcall(rawGetProp, obj, modern)
				if readable and typeof(value) == "Content" then return end
			end
			if obj:IsA("BasePart") and (name == "Position" or name == "Orientation" or name == "Rotation" or name == "BrickColor" or name == "CollisionGroupId") then return end
			if obj:IsA("Attachment") and (name == "Position" or name == "Orientation" or name == "Rotation") then return end
			if obj:IsA("BaseScript") and name == "Enabled" then return end
			if name == "MeshContent" or name == "MeshSize" or name == "MeshId" or name == "CollisionFidelity" or name == "RenderFidelity" or name == "FluidFidelity" then
				if obj:IsA("MeshPart") then return end
			end
			seen[name] = true
			table.insert(list, name)
		end
	end
	local ok, info = pcall(function()
		return Reflection:GetPropertiesOfClass(class, {ExcludeDisplay = true})
	end)
	if ok and info then
		for _, p in ipairs(info) do
			if (p.Serialized or publicEdit[p.Name]) and p.Permits and p.Permits.Write ~= nil then
				add(p.Name)
			end
		end
	end
	for _, group in ipairs({common, props}) do
		for _, name in ipairs(group) do
			local good = pcall(rawGetProp, obj, name)
			if good then add(name) end
		end
	end
	for _, name in ipairs(appearanceProps) do
		local good = pcall(rawGetProp, obj, name)
		if good then add(name) end
	end
	propertyCache[class] = list
	return list
end

local function eligible(obj)
	if obj == script or obj == workspace.CurrentCamera or obj:IsA("Terrain") then return false end
	if obj.Name == "PlaceTogetherTeamTest" or obj:IsDescendantOf(workspace:FindFirstChild("PlaceTogetherTeamTest")) then return false end
	return true
end

local function capture(obj, key)
	local p = {}
	for _, property in ipairs(properties(obj)) do
		local ok, rawVal = pcall(rawGetProp, obj, property)
		if ok then
			local value = encode(rawVal)
			if value ~= nil then
				p[property] = value
			end
			if value == nil and appearanceSet[property] then
				warn(key..":content:"..property, obj.Name.."."..property..": local EditableImage cannot be sent as URI")
			else
				warnings[key..":content:"..property] = nil
			end
		end
	end
	if obj:IsA("Model") and not p.WorldPivot then
		local ok, piv = pcall(obj.GetPivot, obj)
		if ok then p.WorldPivot = encode(piv) end
	end
	if obj:IsA("LuaSourceContainer") then
		local ok, text = pcall(Editor.GetEditorSource, Editor, obj)
		if not ok then
			ok, text = pcall(rawGetProp, obj, "Source")
		end
		if ok and type(text) == "string" then
			p.Source = text:gsub(string.char(13, 10), string.char(10)):gsub(string.char(13), string.char(10))
			warnings[key..":Source"] = nil
		else
			warn(key..":Source", obj.Name..": cannot access script source")
		end
	end
	if obj:IsA("MeshPart") then
		for _, name in ipairs({"MeshId", "MeshContent", "CollisionFidelity", "RenderFidelity", "FluidFidelity"}) do
			local ok, rawVal = pcall(rawGetProp, obj, name)
			if ok then
				local v = encode(rawVal)
				if v then p[name] = v end
			end
		end
	end
	local attrs = {}
	for name, value in pairs(obj:GetAttributes()) do
		if name ~= "PT_ObjectId" and name ~= "PT_SavedRoom" and name ~= "PT_SavedServer" then
			local v = encode(value)
			if v ~= nil then attrs[name] = v end
		end
	end
	local tags = Collection:GetTags(obj)
	if #tags > 1 then
		table.sort(tags)
	end
	return {
		class = obj.ClassName,
		name = obj.Name,
		parent = ids[obj.Parent] or "@game",
		props = p,
		attributes = attrs,
		tags = tags,
		modelScale = obj:IsA("Model") and obj:GetScale() or nil,
	}
end

-- ============================================================
-- EVENT-DRIVEN WATCHERS (O(1) DIRTY TRACKING)
-- ============================================================
local function clearWatchers()
	for _, conns in pairs(objConnections) do
		for _, c in ipairs(conns) do
			pcall(function() c:Disconnect() end)
		end
	end
	objConnections = {}
	for _, c in ipairs(rootConnections) do
		pcall(function() c:Disconnect() end)
	end
	rootConnections = {}
end

local function markObjectAndAncestorsDirty(obj)
	local cur = obj
	while cur and cur ~= game do
		local k = ids[cur]
		if k then
			dirtyKeys[k] = true
		end
		if cur:IsA("Model") or cur == obj then
			cur = cur.Parent
		else
			break
		end
	end
end

local function watchObject(obj, key)
	if objConnections[obj] then return end
	local conns = {}
	table.insert(conns, obj.Changed:Connect(function(prop)
		if applyingRemote then return end
		if prop ~= "Parent" then
			markObjectAndAncestorsDirty(obj)
		end
	end))
	table.insert(conns, obj.AttributeChanged:Connect(function(attr)
		if applyingRemote then return end
		if attr ~= "PT_ObjectId" then
			dirtyKeys[key] = true
		end
	end))
	objConnections[obj] = conns
	table.insert(verifyOrder, key)
end

local function registerNewObject(obj)
	if not eligible(obj) then return end
	if not ids[obj] then
		local existingAttr = obj:GetAttribute("PT_ObjectId")
		local key
		-- Fix Ctrl+D / Copy-Paste collision: if another live instance already owns existingAttr, generate a fresh GUID!
		if type(existingAttr) == "string" and #existingAttr > 0 and #existingAttr <= 512 and (not objects[existingAttr] or objects[existingAttr] == obj) then
			key = existingAttr
		else
			key = Http:GenerateGUID(false)
			pcall(function() obj:SetAttribute("PT_ObjectId", key) end)
		end
		ids[obj] = key
		objects[key] = obj
		watchObject(obj, key)
		dirtyKeys[key] = true
	else
		local key = ids[obj]
		watchObject(obj, key)
		dirtyKeys[key] = true
	end
	for _, child in ipairs(obj:GetChildren()) do
		registerNewObject(child)
	end
end

local function setupRootWatchers()
	for _, name in ipairs(roots) do
		local svc = game:GetService(name)
		table.insert(rootConnections, svc.DescendantAdded:Connect(function(obj)
			if applyingRemote then return end
			registerNewObject(obj)
		end))
		table.insert(rootConnections, svc.DescendantRemoving:Connect(function(obj)
			if applyingRemote then return end
			local key = ids[obj]
			if key then
				dirtyKeys[key] = true
			end
		end))
	end
	pcall(function()
		table.insert(rootConnections, Editor.TextDocumentDidChange:Connect(function(doc)
			if applyingRemote then return end
			pcall(function()
				local scr = doc:GetScript()
				if scr and ids[scr] then
					dirtyKeys[ids[scr]] = true
					local cLine, cCol = doc:GetSelection()
					currentActiveScriptInfo = {
						id = ids[scr],
						name = scr.Name,
						line = cLine or 1,
						col = cCol or 1,
					}
				end
			end)
		end))
		table.insert(rootConnections, Editor.TextDocumentDidOpen:Connect(function(doc)
			pcall(function()
				local scr = doc:GetScript()
				if scr and ids[scr] then
					local cLine, cCol = doc:GetSelection()
					currentActiveScriptInfo = {
						id = ids[scr],
						name = scr.Name,
						line = cLine or 1,
						col = cCol or 1,
					}
				end
			end)
		end))
		table.insert(rootConnections, Editor.TextDocumentDidClose:Connect(function(doc)
			pcall(function()
				local scr = doc:GetScript()
				if scr and ids[scr] and currentActiveScriptInfo and currentActiveScriptInfo.id == ids[scr] then
					currentActiveScriptInfo = nil
				end
			end)
		end))
	end)
end

local function index()
	clearWatchers()
	currentRevision = 0
	objects = {}
	ids = {}
	baseline = {}
	cachedSnapshot = {}
	versions = {}
	dirtyKeys = {}
	verifyOrder = {}
	verifyCursor = 1
	pending = {}
	meshRetry = {}
	referenceRetry = {}
	appearanceRetry = {}
	warnings = {}
	smoothTargets = {}
	terrainReset()

	local function walk(parent, parentId)
		local counts = {}
		for _, obj in ipairs(parent:GetChildren()) do
			if eligible(obj) then
				local stem = obj.ClassName..":"..obj.Name
				counts[stem] = (counts[stem] or 0) + 1
				local key = obj:GetAttribute("PT_ObjectId")
				if type(key) ~= "string" or #key == 0 or #key > 512 or objects[key] then
					key = parentId.."/"..Http:UrlEncode(stem)..":"..counts[stem]
					if #key > 480 then
						key = Http:GenerateGUID(false)
					end
					pcall(function() obj:SetAttribute("PT_ObjectId", key) end)
				end
				objects[key] = obj
				ids[obj] = key
				watchObject(obj, key)
				dirtyKeys[key] = true
				walk(obj, key)
			end
		end
	end

	for _, name in ipairs(roots) do
		local svc = game:GetService(name)
		local sKey = "@"..name
		objects[sKey] = svc
		ids[svc] = sKey
		watchObject(svc, sKey)
		dirtyKeys[sKey] = true
		walk(svc, sKey)
	end
	objects["@Terrain"] = workspace.Terrain
	ids[workspace.Terrain] = "@Terrain"
	serviceIds["@Terrain"] = true

	setupRootWatchers()
end

local function isValidInHierarchy(obj, key)
	if not obj then return false end
	if serviceIds[key] then return true end
	if not obj.Parent then return false end
	for _, name in ipairs(roots) do
		if obj:IsDescendantOf(game:GetService(name)) then
			return true
		end
	end
	return false
end

local function snapshot(forceFull)
	if forceFull then
		for _, name in ipairs(roots) do
			for _, child in ipairs(game:GetService(name):GetChildren()) do
				registerNewObject(child)
			end
		end
		for key in pairs(objects) do
			if key ~= "@Terrain" then
				dirtyKeys[key] = true
			end
		end
	else
		-- Always mark currently selected studio objects + their descendants dirty so active drags/scales sync immediately
		pcall(function()
			for _, sel in ipairs(Selection:Get()) do
				markObjectAndAncestorsDirty(sel)
				if sel:IsA("Model") or sel:IsA("Folder") then
					for _, desc in ipairs(sel:GetDescendants()) do
						local dk = ids[desc]
						if dk then dirtyKeys[dk] = true end
					end
				end
			end
		end)

		-- Lightweight rolling verifier (checks 25 objects per tick in round-robin order, < 0.1ms CPU)
		local totalVerify = #verifyOrder
		if totalVerify > 0 then
			for _ = 1, math.min(25, totalVerify) do
				if verifyCursor > totalVerify then
					verifyCursor = 1
				end
				local vKey = verifyOrder[verifyCursor]
				verifyCursor += 1
				if vKey then
					dirtyKeys[vKey] = true
				end
			end
		end
	end

	-- Re-capture only dirty keys!
	for key in pairs(dirtyKeys) do
		dirtyKeys[key] = nil
		if key ~= "@Terrain" and key:sub(1, 9) ~= "~Terrain/" then
			local obj = objects[key]
			if obj and isValidInHierarchy(obj, key) and (serviceIds[key] or ids[obj.Parent]) then
				local ok, value = pcall(capture, obj, key)
				if ok then
					cachedSnapshot[key] = value
				else
					warn(key..":capture", obj.Name..": error reading object")
					cachedSnapshot[key] = baseline[key]
				end
			else
				cachedSnapshot[key] = nil
				if obj and not isValidInHierarchy(obj, key) and not serviceIds[key] and not pending[key] then
					if objConnections[obj] then
						for _, c in ipairs(objConnections[obj]) do pcall(function() c:Disconnect() end) end
						objConnections[obj] = nil
					end
					ids[obj] = nil
					objects[key] = nil
					smoothTargets[key] = nil
				end
			end
		end
	end

	terrainRecords()
	return cachedSnapshot
end

local function isLocallyDragging(obj)
	if not obj then return false end
	local mouseDown = false
	pcall(function()
		mouseDown = UserInputService:IsMouseButtonPressed(Enum.UserInputType.MouseButton1)
	end)
	if not mouseDown then return false end
	for _, sel in ipairs(Selection:Get()) do
		if sel == obj or obj:IsDescendantOf(sel) then
			return true
		end
	end
	return false
end

local function queueSmoothTransform(key, obj, targetCF, isModel, immediate)
	if immediate or not smoothLerpEnabled then
		smoothTargets[key] = nil
		if isModel then
			obj:PivotTo(targetCF)
		else
			obj.CFrame = targetCF
		end
		return
	end
	if isLocallyDragging(obj) then
		return
	end
	local currentCF = isModel and obj:GetPivot() or obj.CFrame
	local dist = (currentCF.Position - targetCF.Position).Magnitude
	if dist > 80 then
		smoothTargets[key] = nil
		if isModel then
			obj:PivotTo(targetCF)
		else
			obj.CFrame = targetCF
		end
	elseif dist > 0.001 or not currentCF.Rotation:FuzzyEq(targetCF.Rotation, 0.0005) then
		smoothTargets[key] = {
			obj = obj,
			targetCF = targetCF,
			isModel = isModel,
			updatedAt = os.clock(),
		}
	end
end

local function request(method, payload, renewed)
	local reqUrl = endpoint
	if method == "GET" then
		reqUrl = reqUrl .. (reqUrl:find("?") and "&" or "?") .. "_t=" .. tostring(os.clock())
		if currentRevision and currentRevision > 0 then
			reqUrl = reqUrl .. "&since=" .. tostring(currentRevision)
		end
	end

	local response = Http:RequestAsync({
		Url = reqUrl,
		Method = method,
		Headers = {
			Authorization = "Bearer "..credential,
			["Content-Type"] = "application/json",
			["bypass-tunnel-reminder"] = "true",
			["X-PT-Secret"] = serverSecret.Text,
		},
		Body = payload and Http:JSONEncode(payload) or nil
	})

	if response.StatusCode == 401 and guestEnter and not renewed then
		guestEnter()
		return request(method, payload, true)
	end
	local decoded, value = pcall(function() return Http:JSONDecode(response.Body) end)
	if not decoded then
		error("Server returned invalid response (HTTP "..response.StatusCode.."). Retrying...")
	end
	if response.StatusCode == 409 and method == "POST" then
		value.conflict = true
		return value
	end
	if not response.Success then
		error(value.error or ("HTTP "..response.StatusCode))
	end
	return value
end

local function meshSource(value)
	local p = value.props
	if type(p.MeshId) == "string" and p.MeshId ~= "" then return Content.fromUri(p.MeshId) end
	if p.MeshContent and p.MeshContent.t == "Content" and p.MeshContent.v ~= "" then return decode(p.MeshContent) end
	return nil
end

local function loadMesh(obj, key, value)
	if not obj:IsA("MeshPart") then return end
	local source = meshSource(value)
	if not source then return end
	local p = value.props
	local ok, current = pcall(rawGetProp, obj, "MeshId")
	if ok and type(p.MeshId) == "string" and current == p.MeshId then return end
	if meshRetry[key] and meshRetry[key] > os.clock() then return end
	local success = pcall(function()
		local options = {}
		for _, name in ipairs({"CollisionFidelity", "RenderFidelity", "FluidFidelity"}) do
			if p[name] then options[name] = decode(p[name]) end
		end
		local fresh = Assets:CreateMeshPartAsync(source, options)
		if not fresh then error("Roblox did not return mesh geometry") end
		obj:ApplyMesh(fresh)
		fresh:Destroy()
	end)
	if success then
		meshRetry[key] = nil
		warnings[key..":mesh"] = nil
	else
		meshRetry[key] = os.clock() + 15
		warn(key..":mesh", value.name..": Roblox refused to load mesh; other parts continue syncing")
	end
end

local function applyScriptSourceWithCursorPreservation(obj, key, newSource)
	local curText = ""
	local okCur, t = pcall(Editor.GetEditorSource, Editor, obj)
	if okCur and type(t) == "string" then
		curText = t:gsub(string.char(13, 10), string.char(10)):gsub(string.char(13), string.char(10))
	else
		pcall(function() curText = obj.Source end)
	end

	if curText == newSource then return end

	local doc = nil
	pcall(function() doc = Editor:FindScriptDocument(obj) end)

	local cLine, cCol = 1, 1
	if doc then
		pcall(function() cLine, cCol = doc:GetSelection() end)
	end

	local updatedOk = pcall(function()
		Editor:UpdateSourceAsync(obj, function() return newSource end)
	end)
	if not updatedOk then
		pcall(function() obj.Source = newSource end)
	end

	if doc then
		pcall(function()
			local newLines = splitLines(newSource)
			local safeLine = math.clamp(cLine, 1, math.max(1, #newLines))
			doc:SetSelection(safeLine, cCol, safeLine, cCol)
		end)
	end

	if cachedSnapshot[key] and cachedSnapshot[key].props then
		cachedSnapshot[key].props.Source = newSource
	end
	if baseline[key] and baseline[key].props then
		baseline[key].props.Source = newSource
	end
	dirtyKeys[key] = nil
end

local function apply(remote, sent, force)
	local changed = {}
	for key, record in pairs(remote) do
		if force or versions[key] ~= record.version or pending[key] or meshRetry[key] or referenceRetry[key] or (appearanceRetry[key] and appearanceRetry[key] <= os.clock()) then
			changed[key] = {
				version = record.version,
				value = force and copy(record.value) or merge(baseline[key], cachedSnapshot[key], record.value)
			}
		end
	end

	-- If force full sync, also remove any local non-service objects that do not exist on the server
	if force then
		for key, obj in pairs(objects) do
			if not serviceIds[key] and remote[key] == nil then
				changed[key] = {version = currentRevision, value = nil}
			end
		end
	end

	applyingRemote = true
	local frameBudgetStart = os.clock()
	local function checkYield(label)
		if force and (os.clock() - frameBudgetStart > 0.014) then
			applyingRemote = false
			status(label or "Synchronizing place...")
			task.wait()
			applyingRemote = true
			frameBudgetStart = os.clock()
		end
	end

	-- 1. Instantiate missing objects
	for key, r in pairs(changed) do
		if r.value and r.value.class ~= "PTTerrainChunk" and not objects[key] then
			local ok, obj = pcall(Instance.new, r.value.class)
			if ok then
				if obj:IsA("BasePart") then
					for _, s in ipairs({"TopSurface", "BottomSurface", "LeftSurface", "RightSurface", "FrontSurface", "BackSurface"}) do
						obj[s] = Enum.SurfaceType.Smooth
					end
				end
				pcall(function() obj:SetAttribute("PT_ObjectId", key) end)
				objects[key] = obj
				ids[obj] = key
				watchObject(obj, key)
				pending[key] = nil
				warnings[key..":create"] = nil
			else
				pending[key] = true
				warn(key..":create", r.value.name..": class cannot be created via API")
			end
			checkYield("Creating objects...")
		end
	end

	-- 2. Sort hierarchy by parent chain depth so parents are always parented before children
	local function getChangedDepth(key)
		local d = 0
		local curKey = key
		local visited = {}
		while curKey and not serviceIds[curKey] and not visited[curKey] do
			visited[curKey] = true
			d += 1
			local chRec = changed[curKey]
			if chRec and chRec.value then
				curKey = chRec.value.parent
			elseif objects[curKey] and objects[curKey].Parent then
				curKey = ids[objects[curKey].Parent]
			else
				break
			end
		end
		return d
	end

	local parentOrder = {}
	for key, r in pairs(changed) do
		if r.value and objects[key] then
			table.insert(parentOrder, {key = key, r = r, depth = getChangedDepth(key)})
		end
	end
	table.sort(parentOrder, function(a, b) return a.depth < b.depth end)

	for _, item in ipairs(parentOrder) do
		local key, r = item.key, item.r
		local v = r.value
		local obj = objects[key]
		if v and obj then
			local ok = pcall(function()
				if obj.Name ~= v.name then obj.Name = v.name end
				if not serviceIds[key] then
					local parent = objects[v.parent]
					if not parent then error("Parent unavailable") end
					if obj.Parent ~= parent then obj.Parent = parent end
				end
			end)
			if ok then
				pending[key] = nil
				warnings[key..":parent"] = nil
			else
				pending[key] = true
				warn(key..":parent", v.name..": waiting for parent object")
			end
		end
	end

	-- 3. Apply Model Scale
	local models = {}
	for key, r in pairs(changed) do
		local obj = objects[key]
		if r.value and obj and obj:IsA("Model") and r.value.modelScale then
			table.insert(models, {key = key, record = r, obj = obj, depth = getChangedDepth(key)})
		end
	end
	table.sort(models, function(a, b) return a.depth < b.depth end)
	for _, item in ipairs(models) do
		local value = item.record.value.modelScale
		if type(value) == "number" and value > 0 and math.abs(item.obj:GetScale() - value) > 1e-6 then
			pcall(function() item.obj:ScaleTo(value) end)
		end
	end

	-- 4. Apply Properties, Attributes, Tags, or Deletions
	for key, r in pairs(changed) do
		local v = r.value
		local obj = objects[key]
		if not v then
			appearanceRetry[key] = nil
			smoothTargets[key] = nil
		end
		if v and obj and not pending[key] then
			referenceRetry[key] = nil
			appearanceRetry[key] = nil
			loadMesh(obj, key, v)
			local values = {}
			for name, value in pairs(v.props) do
				if not (obj:IsA("MeshPart") and (name == "MeshId" or name == "MeshContent" or name == "CollisionFidelity" or name == "RenderFidelity" or name == "FluidFidelity")) then
					table.insert(values, {name, value})
				end
			end
			local function priority(pair)
				local name, value = pair[1], pair[2]
				if name == "Shape" then return 0 end
				if name == "Size" then return 2 end
				if name == "CFrame" or name == "WorldPivot" then return 3 end
				if type(value) == "table" and value.t == "Instance" then return 4 end
				if name == "Source" then return 5 end
				return 1
			end
			table.sort(values, function(a, b)
				local aa, bb = priority(a), priority(b)
				if aa == bb then return a[1] < b[1] end
				return aa < bb
			end)
			for _, pair in ipairs(values) do
				local name, value = pair[1], pair[2]
				local ok = pcall(function()
					if type(value) == "table" and value.t == "Instance" and not objects[value.v] then
						referenceRetry[key] = true
						error("Linked instance still loading")
					end
					if name == "Source" and obj:IsA("LuaSourceContainer") then
						applyScriptSourceWithCursorPreservation(obj, key, value)
					elseif obj:IsA("Model") and (name == "CFrame" or name == "WorldPivot") then
						local cf = decode(value)
						if typeof(cf) == "CFrame" then
							queueSmoothTransform(key, obj, cf, true, force)
						end
					elseif obj:IsA("BasePart") and name == "CFrame" then
						local cf = decode(value)
						if typeof(cf) == "CFrame" then
							queueSmoothTransform(key, obj, cf, false, force)
						end
					elseif not equal(encode(obj[name]), value) then
						obj[name] = decode(value)
					end
				end)
				if ok then
					warnings[key..":"..name] = nil
				else
					warn(key..":"..name, v.name.."."..name..": unavailable via API")
					if appearanceSet[name] then
						appearanceRetry[key] = os.clock() + 10
					end
				end
			end
			if v.attributes then
				for name in pairs(obj:GetAttributes()) do
					if name ~= "PT_ObjectId" and name ~= "PT_SavedRoom" and name ~= "PT_SavedServer" and v.attributes[name] == nil then
						pcall(function() obj:SetAttribute(name, nil) end)
					end
				end
				for name, value in pairs(v.attributes) do
					pcall(function()
						if not equal(encode(obj:GetAttribute(name)), value) then
							obj:SetAttribute(name, decode(value))
						end
					end)
				end
			end
			if v.tags then
				local tags = {}
				for _, tag in ipairs(v.tags) do
					tags[tag] = true
					if not Collection:HasTag(obj, tag) then Collection:AddTag(obj, tag) end
				end
				for _, tag in ipairs(Collection:GetTags(obj)) do
					if not tags[tag] then Collection:RemoveTag(obj, tag) end
				end
			end
			checkYield("Applying properties...")
		elseif not v and obj and not serviceIds[key] then
			if objConnections[obj] then
				for _, c in ipairs(objConnections[obj]) do pcall(function() c:Disconnect() end) end
				objConnections[obj] = nil
			end
			local ok = pcall(function() obj:Destroy() end)
			if ok then
				ids[obj] = nil
				objects[key] = nil
				cachedSnapshot[key] = nil
				baseline[key] = nil
				pending[key] = nil
				meshRetry[key] = nil
				referenceRetry[key] = nil
				smoothTargets[key] = nil
			else
				warn(key..":delete", obj.Name..": Roblox prevented deletion")
			end
		end
	end

	-- 5. Apply Terrain chunks
	for key, r in pairs(changed) do
		if key:sub(1, 9) == "~Terrain/" then
			applyTerrain(key, r.value)
		end
	end

	-- 6. Update baseline & cachedSnapshot ONLY for affected keys (O(changed) instead of O(entire game)!)
	for key, r in pairs(changed) do
		versions[key] = r.version
		if r.value == nil then
			baseline[key] = nil
			cachedSnapshot[key] = nil
		elseif key:sub(1, 9) == "~Terrain/" then
			baseline[key] = copy(terrainCache[key])
			cachedSnapshot[key] = copy(terrainCache[key])
		else
			local obj = objects[key]
			if obj and isValidInHierarchy(obj, key) then
				local ok, cap = pcall(capture, obj, key)
				if ok then
					-- If CFrame/WorldPivot is currently being smoothly interpolated, record target CFrame in baseline/cache so we don't echo intermediate lerp states back to server!
					if smoothTargets[key] and cap.props then
						if smoothTargets[key].isModel then
							cap.props.WorldPivot = encode(smoothTargets[key].targetCF)
						else
							cap.props.CFrame = encode(smoothTargets[key].targetCF)
						end
					end
					cachedSnapshot[key] = cap
					baseline[key] = acknowledged(r.value, r.value, cap)
				else
					baseline[key] = copy(r.value)
					cachedSnapshot[key] = copy(r.value)
				end
			end
		end
		dirtyKeys[key] = nil
	end
	applyingRemote = false
end

local function blocked(obj, key)
	if pending[key] then return true end
	if not obj then return false end
	local parent = obj.Parent
	while parent and parent ~= game do
		local parentId = ids[parent]
		if parentId and pending[parentId] then return true end
		parent = parent.Parent
	end
	return false
end

local function changes(current)
	local list = {}
	local seen = {}
	for key, value in pairs(current) do
		seen[key] = true
		if not blocked(objects[key], key) and not equal(value, baseline[key]) then
			table.insert(list, {id = key, version = versions[key] or 0, value = value})
		end
	end
	for key in pairs(baseline) do
		if not seen[key] and not pending[key] then
			table.insert(list, {id = key, version = versions[key] or 0, deleted = true})
		end
	end
	return list
end

local function updateSessionStatsUI()
	local count = lastKnownObjectCount
	if count == 0 then
		for k in pairs(cachedSnapshot) do
			if not serviceIds[k] then count += 1 end
		end
	end
	local savedStr = "Auto-save active"
	if lastSaveTimestamp and lastSaveTimestamp > 0 then
		savedStr = "Saved"
	end
	sessionStats.Text = string.format("Rev %d · %d objects · %s", currentRevision, count, savedStr)
end

local function sendChanges(current)
	local list = changes(current)
	if #list > 0 then
		local result = request("POST", {changes = list, since = currentRevision})
		if not result.conflict then
			warnings.syncConflict = nil
			currentRevision = result.revision
			lastKnownObjectCount = result.objectsCount or lastKnownObjectCount
			lastSaveTimestamp = result.lastSaved or lastSaveTimestamp

			for _, ch in ipairs(list) do
				if ch.deleted then
					baseline[ch.id] = nil
					cachedSnapshot[ch.id] = nil
					versions[ch.id] = currentRevision
				else
					baseline[ch.id] = copy(ch.value)
					versions[ch.id] = currentRevision
				end
			end

			if result.remoteChanges and next(result.remoteChanges) then
				apply(result.remoteChanges, current, false)
			end
			updateSessionStatsUI()
			return {revision = currentRevision, objects = {}}
		end
	end

	local latest = request("GET")
	lastKnownObjectCount = latest.objectsCount or lastKnownObjectCount
	lastSaveTimestamp = latest.lastSaved or lastSaveTimestamp

	if latest.unchanged then
		updateSessionStatsUI()
		return {revision = currentRevision, objects = {}}
	end

	currentRevision = latest.revision
	if latest.delta then
		apply(latest.objects, current, false)
	else
		apply(latest.objects, current, true)
	end

	warnings.syncConflict = nil
	updateSessionStatsUI()
	return latest
end

-- ============================================================
-- SESSION & NETWORK MANAGEMENT
-- ============================================================
local inbox = nil
local lastSent = nil
local inviting = false
local polling = false

local function base()
	return address.Text:gsub("%s+", ""):gsub("/+$", "")
end

local function api(path, method, payload, renewed)
	local reqUrl = base().."/api"..path
	if (method or "GET") == "GET" then
		reqUrl = reqUrl .. (reqUrl:find("?") and "&" or "?") .. "_t=" .. tostring(os.clock())
	end

	local response = Http:RequestAsync({
		Url = reqUrl,
		Method = method or "GET",
		Headers = {
			Authorization = "Bearer "..token.Text,
			["Content-Type"] = "application/json",
			["bypass-tunnel-reminder"] = "true",
			["X-PT-Secret"] = serverSecret.Text,
		},
		Body = payload and Http:JSONEncode(payload) or nil
	})
	if response.StatusCode == 401 and path ~= "/guest" and not renewed then
		guestEnter()
		return api(path, method, payload, true)
	end
	local decoded, data = pcall(function() return Http:JSONDecode(response.Body) end)
	if not decoded then
		error("Server unavailable (HTTP "..response.StatusCode.."). Check server address and verify server is running.")
	end
	if not response.Success then
		error(data.error or ("HTTP "..response.StatusCode))
	end
	return data
end

local function saveRoomNow(customLabel)
	if not active or room.Text == "" then
		status("Connect to a room first before saving.")
		return
	end
	local ok, res = pcall(function()
		local current = snapshot(false)
		sendChanges(current)
		return api("/rooms/"..room.Text.."/save", "POST", {
			name = sessionTitle.Text,
			label = customLabel or "manual",
			snapshot = true
		})
	end)
	if ok and res then
		lastSaveTimestamp = res.lastSaved or os.time()
		lastKnownObjectCount = res.objectsCount or lastKnownObjectCount
		updateSessionStatsUI()
		local storage = game:GetService("ReplicatedStorage")
		pcall(function()
			storage:SetAttribute("PT_SavedRoom", room.Text)
			storage:SetAttribute("PT_SavedServer", base())
		end)
		status("Saved room & backup snapshot! (Rev "..tostring(res.revision)..", "..tostring(res.objectsCount).." objects)")
	else
		status("Save failed: "..tostring(res))
	end
end

quickSaveBtn.MouseButton1Click:Connect(function()
	saveRoomNow("quick_save")
end)

local function connectSession()
	if busy then return end
	if active then
		if Run:IsRunning() then
			status("Stop Play mode before leaving session.")
			return
		end
		busy = true
		local ok, err = pcall(function()
			local current = snapshot(false)
			sendChanges(current)
			api("/rooms/"..room.Text.."/save", "POST", {label = "leave_autosave", snapshot = false})
		end)
		busy = false
		if not ok then
			status("Cannot leave: unsent changes. "..tostring(err))
			return
		end
		restoreSuppressed = true
		active = false
		clearWatchers()
		smoothTargets = {}
		connect.Text = "Reconnect to Session"
		status("Session saved & disconnected. Safe to close local place.")
		return
	end

	if Run:IsRunning() then
		status("Stop Play/Test mode before connecting.")
		return
	end
	busy = true
	local ok, err = pcall(function()
		if setup.Text:match("^%s*{") then
			local c = Http:JSONDecode(setup.Text)
			address.Text = c.server
			room.Text = c.room
			token.Text = c.token
			if type(c.secret) == "string" then
				serverSecret.Text = c.secret
				plugin:SetSetting("PTSecret", c.secret)
			end
			setup.Text = ""
		end
		local b = base()
		if not b:match("^https?://") then
			error("Enter server address with http:// or https://")
		end
		endpoint = b.."/api/rooms/"..room.Text.."/sync"
		credential = token.Text
		plugin:SetSetting("PTAddress", b)
		plugin:SetSetting("PTRoom", room.Text)

		index()
		local current = snapshot(true)
		local state = request("GET")
		if state.unchanged or next(state.objects or {}) == nil then
			if not state.owner then
				error("Host has not published the place yet")
			end
			state = sendChanges(current)
		end

		if state.objects and next(state.objects) ~= nil then
			apply(state.objects, current, true)
		end
		currentRevision = state.revision or currentRevision
		lastKnownObjectCount = state.objectsCount or lastKnownObjectCount
		lastSaveTimestamp = state.lastSaved or lastSaveTimestamp

		for key, value in pairs(cachedSnapshot) do
			if not versions[key] then
				baseline[key] = copy(value)
				versions[key] = currentRevision
			end
		end

		local storage = game:GetService("ReplicatedStorage")
		pcall(function()
			storage:SetAttribute("PT_SavedRoom", room.Text)
			storage:SetAttribute("PT_SavedServer", b)
		end)

		active = true
		accept.Visible = false
		connect.Text = "Leave Session"
		updateSessionStatsUI()
		status("Place connected! Real-time 60FPS sync & auto-save enabled."..warningText())
	end)
	busy = false
	if not ok then
		active = false
		status(tostring(err))
		accept.Visible = (endpoint ~= nil)
	end
end

guestEnter = function(rename)
	if not base():match("^https?://") then
		status("Enter server address in Settings tab")
		return
	end
	local key = plugin:GetSetting("PTGuestDeviceKey") or plugin:GetSetting("PTGuestDeviceKey:"..base())
	if type(key) ~= "string" or #key ~= 64 then
		key = (Http:GenerateGUID(false)..Http:GenerateGUID(false)):gsub("-", ""):lower()
		plugin:SetSetting("PTGuestDeviceKey:"..base(), key)
	end
	if selfNick.Text == "" then
		pcall(function()
			local uid = game:GetService("StudioService"):GetUserId()
			if uid > 0 then
				selfNick.Text = game:GetService("Players"):GetNameFromUserIdAsync(uid)
			end
		end)
		if selfNick.Text == "" then
			selfNick.Text = "User_"..key:sub(1, 6)
		end
	end
	plugin:SetSetting("PTGuestDeviceKey", key)
	local value = api("/guest", "POST", {name = selfNick.Text, deviceKey = key, rename = (rename == true)})
	token.Text = value.token
	credential = value.token
	selfNick.Text = value.name
	loggedIn = true
	plugin:SetSetting("PTInviteToken:"..base(), value.token)
	plugin:SetSetting("PTInviteName", value.name)
	plugin:SetSetting("PTAddress", base())
	status("Connected as "..value.name..". Ready to host or join.")
	return value
end

local function openHost()
	if not loggedIn then guestEnter() end
	if active then return end
	local storage = game:GetService("ReplicatedStorage")
	local saved = storage:GetAttribute("PT_SavedRoom")
	if type(saved) == "string" and saved:match("^[a-f0-9]+$") and storage:GetAttribute("PT_SavedServer") == base() then
		local accessible, info = pcall(function() return api("/rooms/"..saved.."/state") end)
		if accessible and not info.closed then
			room.Text = saved
			sessionTitle.Text = info.name
			connectSession()
			if not active then error(notice.Text) end
			return
		end
		storage:SetAttribute("PT_SavedRoom", nil)
		storage:SetAttribute("PT_SavedServer", nil)
		restoreSuppressed = true
		room.Text = ""
	end
	local placeName = (game.Name and game.Name ~= "" and game.Name ~= "Game") and game.Name or ("Project_"..os.date("%H%M"))
	local value = api("/rooms", "POST", {name = placeName})
	room.Text = value.id
	sessionTitle.Text = value.name
	connectSession()
	if not active then error(notice.Text) end
	storage:SetAttribute("PT_SavedRoom", value.id)
	storage:SetAttribute("PT_SavedServer", base())
	connect.Visible = true
	pcall(function() api("/rooms/"..room.Text.."/save", "POST", {label = "initial", snapshot = true}) end)
end

hostStartBtn.MouseButton1Click:Connect(function()
	if busy or inviting or active then return end
	local ok, err = pcall(openHost)
	if not ok then status("Failed to start hosting: "..tostring(err)) end
end)

local function inviteUser()
	if inviting then return end
	inviting = true
	local ok, err = pcall(function()
		if #nick.Text:gsub("%s+", "") < 2 then error("Enter friend's plugin username") end
		openHost()
		local sent = api("/invitations", "POST", {room = room.Text, nick = nick.Text})
		lastSent = sent.id
		inviteStatus.Text = sent.recipientOnline and ("Waiting for acceptance: "..nick.Text) or ("Invitation sent! Waiting for '"..nick.Text.."' to connect.")
		status(inviteStatus.Text)
	end)
	inviting = false
	if not ok then
		inviteStatus.Text = tostring(err)
		status(tostring(err))
	end
end
invite.MouseButton1Click:Connect(inviteUser)

local function emptyPlace()
	for _, service in ipairs({"ReplicatedStorage", "ServerScriptService", "ServerStorage", "StarterGui", "StarterPack"}) do
		if #game:GetService(service):GetChildren() > 0 then return false end
	end
	for _, obj in ipairs(workspace:GetChildren()) do
		if not obj:IsA("Terrain") and not obj:IsA("Camera") and obj.Name ~= "Baseplate" and not obj:IsA("SpawnLocation") then
			return false
		end
	end
	return true
end

local function focusImportedPlace()
	local low = Vector3.new(math.huge, math.huge, math.huge)
	local high = Vector3.new(-math.huge, -math.huge, -math.huge)
	local count = 0
	for _, obj in pairs(objects) do
		if obj:IsA("BasePart") and obj:IsDescendantOf(workspace) and obj.Name ~= "Baseplate" then
			local a = obj.Position - obj.Size / 2
			local b = obj.Position + obj.Size / 2
			low = Vector3.new(math.min(low.X, a.X), math.min(low.Y, a.Y), math.min(low.Z, a.Z))
			high = Vector3.new(math.max(high.X, b.X), math.max(high.Y, b.Y), math.max(high.Z, b.Z))
			count += 1
		end
	end
	if count > 0 and workspace.CurrentCamera then
		local center = (low + high) / 2
		local span = high - low
		local distance = math.clamp(math.max(span.X, span.Y, span.Z) * 1.1, 20, 400)
		workspace.CurrentCamera.CFrame = CFrame.lookAt(center + Vector3.new(distance * 0.65, distance * 0.5, distance), center)
		workspace.CurrentCamera.Focus = CFrame.new(center)
	end
end

local function joinExistingRoomById(targetRoomId, targetRoomName)
	if busy or inviting then return end
	if active then
		status("Leave current session first before switching rooms.")
		return
	end
	inviting = true
	local ok, err = pcall(function()
		api("/rooms/"..targetRoomId.."/join", "POST", {})
		room.Text = targetRoomId
		sessionTitle.Text = targetRoomName or "Studio Project"
		index()
		local initial = api("/rooms/"..room.Text.."/sync")
		if initial.objects and next(initial.objects) ~= nil then
			local defaults = {}
			for _, obj in ipairs(workspace:GetChildren()) do
				if obj.Name == "Baseplate" or obj:IsA("SpawnLocation") then
					table.insert(defaults, obj)
				end
			end
			connectSession()
			connect.Visible = active
			if not active then error(notice.Text) end
			applyingRemote = true
			for _, obj in ipairs(defaults) do
				local key = ids[obj]
				if key and not initial.objects[key] then
					baseline[key] = nil
					cachedSnapshot[key] = nil
					objects[key] = nil
					ids[obj] = nil
					pcall(function() obj:Destroy() end)
				end
			end
			applyingRemote = false
			focusImportedPlace()
		else
			connectSession()
			connect.Visible = active
		end
		uiTab = "home"
	end)
	inviting = false
	if not ok then status("Failed to join room: "..tostring(err)) end
end

local function acceptInvitation()
	if not inbox or inviting or busy then return end
	if active then status("Disconnect from current session first."); return end
	if not emptyPlace() then status("Open a new empty Baseplate (File -> New) before accepting invite."); return end
	inviting = true
	local ok, err = pcall(function()
		local result = api("/invitations/"..inbox.id.."/respond", "POST", {decision = "accept"})
		local targetId = result.room.id
		local targetName = result.room.name
		inbox = nil
		yes.Visible = false
		no.Visible = false
		inviting = false
		joinExistingRoomById(targetId, targetName)
		incoming.Text = "Collaborating on "..targetName.." together."
	end)
	inviting = false
	if not ok then status(tostring(err)) end
end
yes.MouseButton1Click:Connect(acceptInvitation)

retry.MouseButton1Click:Connect(function()
	if busy or active or room.Text == "" then return end
	connectSession()
	connect.Visible = active
	if active then focusImportedPlace() end
end)

no.MouseButton1Click:Connect(function()
	if not inbox or inviting then return end
	inviting = true
	local ok, err = pcall(function()
		api("/invitations/"..inbox.id.."/respond", "POST", {decision = "decline"})
		inbox = nil
		yes.Visible = false
		no.Visible = false
		incoming.Text = "Invitation declined."
	end)
	inviting = false
	if not ok then status(tostring(err)) end
end)

connect.MouseButton1Click:Connect(connectSession)

accept.MouseButton1Click:Connect(function()
	if busy or not endpoint then return end
	busy = true
	local ok, err = pcall(function()
		local current = snapshot(true)
		local state = request("GET")
		apply(state.objects, current, true)
		active = true
		connect.Visible = true
		accept.Visible = false
		status("Server version accepted.")
	end)
	busy = false
	if not ok then status(tostring(err)) end
end)

-- ============================================================
-- SAVES & BACKUPS UI LOGIC
-- ============================================================
local function clearContainerChildren(c)
	for _, child in ipairs(c:GetChildren()) do
		if not child:IsA("UIListLayout") and not child:IsA("UIPadding") then
			child:Destroy()
		end
	end
end

local function refreshSavesAndBackupsUI()
	if not loggedIn then
		status("Connect to server first to view saved rooms & backups.")
		return
	end
	task.spawn(function()
		-- 1. Load Rooms List
		local okRooms, roomsData = pcall(function() return api("/rooms") end)
		if okRooms and type(roomsData) == "table" then
			clearContainerChildren(roomsListContainer)
			if #roomsData == 0 then
				textLabel("No rooms saved on server yet.", 20, roomsListContainer)
			else
				for i, r in ipairs(roomsData) do
					if i > 10 then break end
					local isCurrent = (room.Text == r.id and active)
					local btnLabel = string.format(
						"%s%s (Rev %d · %d objs)",
						isCurrent and "[ACTIVE] " or "",
						tostring(r.name or r.id),
						tonumber(r.revision or 1),
						tonumber(r.objectsCount or 0)
					)
					local b = makeButton(btnLabel, roomsListContainer, isCurrent and "success" or nil, 32)
					b.MouseButton1Click:Connect(function()
						if isCurrent then
							uiTab = "home"
						else
							joinExistingRoomById(r.id, r.name)
						end
					end)
				end
			end
		end

		-- 2. Load Backups for Current Room
		clearContainerChildren(backupsListContainer)
		if room.Text == "" then
			textLabel("Join or host a room to view its backup history.", 20, backupsListContainer)
		else
			local okBackups, backupsData = pcall(function() return api("/rooms/"..room.Text.."/backups") end)
			if okBackups and type(backupsData) == "table" then
				if #backupsData == 0 then
					textLabel("No backups yet. Click 'Save & Create Checkpoint' above.", 20, backupsListContainer)
				else
					for i, bk in ipairs(backupsData) do
						if i > 12 then break end
						local labelText = string.format(
							"Restore: %s [%s] (Rev %d · %d objs)",
							tostring(bk.date or bk.id),
							tostring(bk.label or "snap"),
							tonumber(bk.revision or 1),
							tonumber(bk.objectsCount or 0)
						)
						local b = makeButton(labelText, backupsListContainer, nil, 32)
						b.MouseButton1Click:Connect(function()
							if busy then return end
							status("Restoring backup "..tostring(bk.id).."...")
							local okRest, resRest = pcall(function()
								return api("/rooms/"..room.Text.."/restore", "POST", {backupId = bk.id})
							end)
							if okRest and resRest then
								status("Backup restored! Syncing "..tostring(resRest.objectsCount).." objects (Rev "..tostring(resRest.revision)..")")
								uiTab = "home"
							else
								status("Restore failed: "..tostring(resRest))
							end
						end)
					end
				end
			end
		end
	end)
end

for key, b in pairs(tabButtons) do
	b.MouseButton1Click:Connect(function()
		uiTab = key
		if key == "saves" then
			refreshSavesAndBackupsUI()
		end
	end)
end

createSnapBtn.MouseButton1Click:Connect(function()
	local lbl = manualSnapName.Text ~= "" and manualSnapName.Text or "checkpoint"
	saveRoomNow(lbl)
	manualSnapName.Text = ""
	refreshSavesAndBackupsUI()
end)

refreshSavesBtn.MouseButton1Click:Connect(refreshSavesAndBackupsUI)

-- ============================================================
-- BACKGROUND LOOPS (INVITATIONS & FAST 6.6Hz DELTA SYNC)
-- ============================================================
task.spawn(function()
	if selfNick.Text == "" then
		pcall(function()
			local uid = game:GetService("StudioService"):GetUserId()
			if uid > 0 then
				selfNick.Text = game:GetService("Players"):GetNameFromUserIdAsync(uid)
			end
		end)
	end
	if address.Text ~= "" and address.Text:match("^https?://") then
		local ready, reason = pcall(guestEnter)
		if not ready then
			status("Server offline. Start StartPlaceTogetherServer.bat ("..tostring(reason)..")")
		end
	else
		status("Enter server address in Settings tab")
	end

	while true do
		task.wait(1.5)
		if not loggedIn and not inviting and not polling then
			pcall(guestEnter)
		end
		if loggedIn and not polling and not inviting then
			polling = true
			local ok, err = pcall(function()
				local invitationsList = api("/invitations")
				if lastSent then
					for _, sent in ipairs(api("/invitations/outbox")) do
						if sent.id == lastSent then
							if sent.state == "accepted" then
								inviteStatus.Text = "Friend accepted invitation!"
								lastSent = nil
							elseif sent.state == "declined" then
								inviteStatus.Text = "Friend declined invitation."
								lastSent = nil
							elseif sent.delivered then
								inviteStatus.Text = "Delivered to friend's plugin. Waiting for acceptance."
							elseif sent.recipientOnline then
								inviteStatus.Text = "Friend is online. Delivering invitation..."
							else
								inviteStatus.Text = "Waiting for '"..nick.Text.."' to connect to server..."
							end
						end
					end
				end
				local nextInvite = invitationsList[#invitationsList]
				if nextInvite and (not inbox or inbox.id ~= nextInvite.id) then
					inbox = nextInvite
					incoming.Text = nextInvite.from.." invited you to '"..nextInvite.place.."'. Open an empty Baseplate before accepting."
					yes.Visible = true
					no.Visible = true
					uiTab = "home"
					widget.Enabled = true
				elseif not nextInvite and inbox then
					inbox = nil
					yes.Visible = false
					no.Visible = false
					incoming.Text = "No new invitations."
				end
			end)
			polling = false
			if not ok then
				incoming.Text = "Failed to check invitations: "..tostring(err)
			end
		end
	end
end)

-- High-frequency incremental sync loop (0.15s = ~6.6 Hz, O(dirty) overhead < 0.05ms)
task.spawn(function()
	local backoff = 0
	while true do
		task.wait(0.15 + backoff)
		if active and not busy and not Run:IsRunning() then
			busy = true
			local ok, err = pcall(function()
				local current = snapshot(false)
				local state = sendChanges(current)
				status(
					(warnings.syncConflict and "Unsent changes pending" or ("Live · Rev "..state.revision))
					.. " · Room " .. room.Text:sub(1, 8)
					.. warningText()
				)
			end)
			busy = false
			if ok then
				backoff = 0
			else
				-- Server unreachable or overloaded: slow down instead of hammering it at 6.6 Hz.
				backoff = math.min(backoff > 0 and backoff * 2 or 0.5, 5)
				status("Sync retrying automatically: "..tostring(err))
			end
		elseif active and Run:IsRunning() then
			status("Sync paused during Play mode. Stop game to resume editing.")
		end
	end
end)

plugin.Unloading:Connect(function()
	if active and not busy and not Run:IsRunning() then
		busy = true
		pcall(function()
			local current = snapshot(false)
			sendChanges(current)
			api("/rooms/"..room.Text.."/save", "POST", {label = "unload_autosave", snapshot = false})
		end)
		busy = false
	end
	clearWatchers()
	active = false
	loggedIn = false
end)

logout.MouseButton1Click:Connect(function()
	if busy or inviting then return end
	inviting = true
	local ok, err = pcall(guestEnter)
	inviting = false
	if not ok then
		status("Check server in Settings. "..tostring(err))
	end
end)

local previousAddress = base()
address.FocusLost:Connect(function()
	if base() == previousAddress then return end
	if busy or inviting then
		address.Text = previousAddress
		status("Please wait for current operation to finish.")
		return
	end
	previousAddress = base()
	active = false
	loggedIn = false
	inbox = nil
	room.Text = ""
	token.Text = ""
	yes.Visible = false
	no.Visible = false
	plugin:SetSetting("PTAddress", base())
	uiTab = "home"
	local ok, err = pcall(guestEnter)
	if not ok then
		status("Failed to connect to new server. "..tostring(err))
	end
end)

selfNick.FocusLost:Connect(function()
	if busy or inviting then return end
	local old = plugin:GetSetting("PTInviteName") or ""
	if selfNick.Text == old then return end
	inviting = true
	local ok, err = pcall(function() guestEnter(true) end)
	inviting = false
	if not ok then
		selfNick.Text = old
		status(tostring(err))
	end
end)

task.spawn(function()
	while true do
		refreshUI(active, loggedIn, inbox ~= nil, busy or inviting)
		task.wait(0.2)
	end
end)

