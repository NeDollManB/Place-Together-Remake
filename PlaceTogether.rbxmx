local function getTeamTestFolder()
	local folder = workspace:FindFirstChild("PlaceTogetherTeamTest")
	if not folder then
		folder = Instance.new("Folder")
		folder.Name = "PlaceTogetherTeamTest"
		folder.Archivable = false
		folder.Parent = workspace
	end
	return folder
end

local function getSpawnLocation()
	local spawns = {}
	for _, desc in ipairs(workspace:GetDescendants()) do
		if desc:IsA("SpawnLocation") and desc.Enabled then
			table.insert(spawns, desc)
		end
	end
	if #spawns > 0 then
		local s = spawns[math.random(1, #spawns)]
		return s.Position + Vector3.new(0, 3.5, 0)
	end
	local cam = workspace.CurrentCamera
	if cam then
		return cam.CFrame.Position + cam.CFrame.LookVector * 8 + Vector3.new(0, 2, 0)
	end
	return Vector3.new(0, 10, 0)
end

