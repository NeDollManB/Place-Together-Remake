local function animateAvatar(char, state, stepTimer, idleTimer)
	local root = char.PrimaryPart
	if not root then return end
	local rootCF = root.CFrame

	local torso = char:FindFirstChild("Torso") or char:FindFirstChild("UpperTorso")
	local head = char:FindFirstChild("Head")
	local leftArm = char:FindFirstChild("Left Arm") or char:FindFirstChild("LeftUpperArm")
	local rightArm = char:FindFirstChild("Right Arm") or char:FindFirstChild("RightUpperArm")
	local leftLeg = char:FindFirstChild("Left Leg") or char:FindFirstChild("LeftUpperLeg")
	local rightLeg = char:FindFirstChild("Right Leg") or char:FindFirstChild("RightUpperLeg")

	if torso and head and leftArm and rightArm and leftLeg and rightLeg then
		if state == "Running" or state == "Walking" then
			local amp = (state == "Running") and 0.85 or 0.6
			local swing = math.sin(stepTimer) * amp
			torso.CFrame = rootCF * CFrame.new(0, math.abs(math.sin(stepTimer * 2)) * 0.15, 0)
			head.CFrame = torso.CFrame * CFrame.new(0, 1.5, 0)
			leftLeg.CFrame = rootCF * CFrame.new(-0.5, -1, 0) * CFrame.Angles(swing, 0, 0) * CFrame.new(0, -1, 0)
			rightLeg.CFrame = rootCF * CFrame.new(0.5, -1, 0) * CFrame.Angles(-swing, 0, 0) * CFrame.new(0, -1, 0)
			leftArm.CFrame = torso.CFrame * CFrame.new(-1.5, 0.5, 0) * CFrame.Angles(-swing * 0.8, 0, 0) * CFrame.new(0, -1, 0)
			rightArm.CFrame = torso.CFrame * CFrame.new(1.5, 0.5, 0) * CFrame.Angles(swing * 0.8, 0, 0) * CFrame.new(0, -1, 0)
		elseif state == "Jumping" then
			torso.CFrame = rootCF * CFrame.new(0, 0.2, 0)
			head.CFrame = torso.CFrame * CFrame.new(0, 1.5, 0)
			leftLeg.CFrame = rootCF * CFrame.new(-0.5, -0.7, 0.3) * CFrame.Angles(-0.5, 0, 0) * CFrame.new(0, -1, 0)
			rightLeg.CFrame = rootCF * CFrame.new(0.5, -0.7, 0.3) * CFrame.Angles(-0.5, 0, 0) * CFrame.new(0, -1, 0)
			leftArm.CFrame = torso.CFrame * CFrame.new(-1.5, 0.8, 0) * CFrame.Angles(2.8, 0, 0) * CFrame.new(0, -1, 0)
			rightArm.CFrame = torso.CFrame * CFrame.new(1.5, 0.8, 0) * CFrame.Angles(2.8, 0, 0) * CFrame.new(0, -1, 0)
		elseif state == "Freefall" then
			torso.CFrame = rootCF
			head.CFrame = torso.CFrame * CFrame.new(0, 1.5, 0)
			leftLeg.CFrame = rootCF * CFrame.new(-0.5, -0.8, 0.2) * CFrame.Angles(-0.3, 0, 0) * CFrame.new(0, -1, 0)
			rightLeg.CFrame = rootCF * CFrame.new(0.5, -0.8, 0.2) * CFrame.Angles(-0.3, 0, 0) * CFrame.new(0, -1, 0)
			leftArm.CFrame = torso.CFrame * CFrame.new(-1.5, 0.5, 0) * CFrame.Angles(1.2, 0, 0.6) * CFrame.new(0, -1, 0)
			rightArm.CFrame = torso.CFrame * CFrame.new(1.5, 0.5, 0) * CFrame.Angles(1.2, 0, -0.6) * CFrame.new(0, -1, 0)
		else -- Idle
			local breathe = math.sin(idleTimer * 2) * 0.05
			torso.CFrame = rootCF * CFrame.new(0, breathe, 0)
			head.CFrame = torso.CFrame * CFrame.new(0, 1.5, 0)
			leftLeg.CFrame = rootCF * CFrame.new(-0.5, -1, 0) * CFrame.new(0, -1, 0)
			rightLeg.CFrame = rootCF * CFrame.new(0.5, -1, 0) * CFrame.new(0, -1, 0)
			leftArm.CFrame = torso.CFrame * CFrame.new(-1.5, 0.5, 0) * CFrame.Angles(breathe * 0.5, 0, 0.05) * CFrame.new(0, -1, 0)
			rightArm.CFrame = torso.CFrame * CFrame.new(1.5, 0.5, 0) * CFrame.Angles(breathe * 0.5, 0, -0.05) * CFrame.new(0, -1, 0)
		end
	end
end

local function stopTeamTest()
	if not teamTestActive then return end
	teamTestActive = false

	if localTesterChar then
		localTesterChar:Destroy()
		localTesterChar = nil
	end
	if hudGui then
		hudGui:Destroy()
		hudGui = nil
		hudActiveUsersLabel = nil
		hudChatBox = nil
	end

	for id, t in pairs(remoteTesters) do
		if t.model then t.model:Destroy() end
		remoteTesters[id] = nil
	end

	pcall(function()
		workspace.CurrentCamera.CameraType = Enum.CameraType.Fixed
		if origCamCF then
			workspace.CurrentCamera.CFrame = origCamCF
		end
		task.wait(0.02)
		workspace.CurrentCamera.CameraType = Enum.CameraType.Custom
	end)

	toggleTeamTestBtn.Text = "▶ Start Team Test"
	toggleTeamTestBtn.TextColor3 = palette.ink
	toggleTeamTestBtn.BackgroundColor3 = palette.accent
	status("Team Test ended. Back in Studio edit mode.")
end

local function broadcastChatMessage(text)
	text = tostring(text or ""):gsub("^%s+", ""):gsub("%s+$", "")
	if #text == 0 then return end
	myChatBubbleText = text
	myChatBubbleTime = os.clock() + 6.0
	if localCharBubbleFrame and localCharBubbleLabel then
		localCharBubbleLabel.Text = text
		localCharBubbleFrame.Visible = true
	end
end

local function startTeamTest()
	if not active then
		status("Connect to a session first before starting Team Test.")
		return
	end
	if teamTestActive then
		stopTeamTest()
		return
	end

	teamTestFolder = getTeamTestFolder()
	origCamCF = workspace.CurrentCamera and workspace.CurrentCamera.CFrame or nil
	origCamType = workspace.CurrentCamera and workspace.CurrentCamera.CameraType or nil

	local spawnPos = getSpawnLocation()
	localPos = spawnPos
	localVertVel = 0
	localGrounded = true
	localState = "Idle"
	localStepTimer = 0
	localIdleTimer = 0
	camYaw = 0
	camPitch = 0.2
	camDist = 12

	local uid = 0
	pcall(function() uid = game:GetService("StudioService"):GetUserId() end)
	local char, nickL, bFrame, bLabel = buildRobloxAvatar(selfNick.Text, uid, palette.green)
	char.Parent = teamTestFolder
	char:PivotTo(CFrame.new(spawnPos))
	localTesterChar = char
	localCharNickLabel = nickL
	localCharBubbleFrame = bFrame
	localCharBubbleLabel = bLabel

	nickL.Text = selfNick.Text .. " (You)"
	nickL.TextColor3 = palette.green

	pcall(function()
		workspace.CurrentCamera.CameraType = Enum.CameraType.Scriptable
	end)

	-- Create HUD
	if hudGui then hudGui:Destroy() end
	local gui = Instance.new("ScreenGui")
	gui.Name = "PlaceTogetherTeamTestHUD"
	gui.ResetOnSpawn = false
	gui.DisplayOrder = 9999
	gui.Parent = game:GetService("CoreGui")

	local topBar = Instance.new("Frame")
	topBar.Size = UDim2.new(0, 520, 0, 40)
	topBar.Position = UDim2.new(0.5, -260, 0, 16)
	topBar.BackgroundColor3 = Color3.fromRGB(15, 17, 23)
	topBar.BorderSizePixel = 0
	topBar.Parent = gui
	corner(topBar, 10)
	stroke(topBar, Color3.fromRGB(36, 43, 58), 1)

	local gDot = Instance.new("Frame")
	gDot.Size = UDim2.fromOffset(8, 8)
	gDot.Position = UDim2.fromOffset(14, 16)
	gDot.BackgroundColor3 = palette.green
	gDot.BorderSizePixel = 0
	gDot.Parent = topBar
	corner(gDot, 4)

	local titleL = Instance.new("TextLabel")
	titleL.Size = UDim2.new(0, 150, 1, 0)
	titleL.Position = UDim2.fromOffset(28, 0)
	titleL.BackgroundTransparency = 1
	titleL.Font = Enum.Font.GothamBold
	titleL.TextSize = 12
	titleL.TextColor3 = palette.text
	titleL.TextXAlignment = Enum.TextXAlignment.Left
	titleL.Text = "TEAM TEST (CO-OP)"
	titleL.Parent = topBar

	local actL = Instance.new("TextLabel")
	actL.Name = "ActiveUsers"
	actL.Size = UDim2.new(0, 150, 1, 0)
	actL.Position = UDim2.fromOffset(165, 0)
	actL.BackgroundTransparency = 1
	actL.Font = Enum.Font.GothamMedium
	actL.TextSize = 11
	actL.TextColor3 = palette.muted
	actL.TextXAlignment = Enum.TextXAlignment.Left
	actL.Text = "👥 You"
	actL.Parent = topBar
	hudActiveUsersLabel = actL

	local respawnBtn = Instance.new("TextButton")
	respawnBtn.Size = UDim2.fromOffset(76, 26)
	respawnBtn.Position = UDim2.new(1, -165, 0.5, -13)
	respawnBtn.BackgroundColor3 = Color3.fromRGB(28, 33, 45)
	respawnBtn.BorderSizePixel = 0
	respawnBtn.Font = Enum.Font.GothamBold
	respawnBtn.TextSize = 11
	respawnBtn.TextColor3 = palette.text
	respawnBtn.Text = "Respawn"
	respawnBtn.Parent = topBar
	corner(respawnBtn, 6)
	respawnBtn.MouseButton1Click:Connect(function()
		localPos = getSpawnLocation()
		localVertVel = 0
		localGrounded = true
		if localTesterChar then localTesterChar:PivotTo(CFrame.new(localPos)) end
		status("Respawned at spawn location.")
	end)

	local exitBtn = Instance.new("TextButton")
	exitBtn.Size = UDim2.fromOffset(76, 26)
	exitBtn.Position = UDim2.new(1, -84, 0.5, -13)
	exitBtn.BackgroundColor3 = palette.dangerBg
	exitBtn.BorderSizePixel = 0
	exitBtn.Font = Enum.Font.GothamBold
	exitBtn.TextSize = 11
	exitBtn.TextColor3 = Color3.fromRGB(252, 165, 165)
	exitBtn.Text = "Exit Test"
	exitBtn.Parent = topBar
	corner(exitBtn, 6)
	stroke(exitBtn, palette.dangerBorder, 1)
	exitBtn.MouseButton1Click:Connect(stopTeamTest)

	local hintL = Instance.new("TextLabel")
	hintL.Size = UDim2.new(0, 560, 0, 22)
	hintL.Position = UDim2.new(0.5, -280, 1, -38)
	hintL.BackgroundColor3 = Color3.fromRGB(15, 17, 23)
	hintL.BackgroundTransparency = 0.2
	hintL.Font = Enum.Font.GothamMedium
	hintL.TextSize = 11
	hintL.TextColor3 = palette.muted
	hintL.Text = "[WASD] Move   ·   [Space] Jump   ·   [Shift] Sprint   ·   [Hold RMB] Look   ·   [/] Chat"
	hintL.Parent = gui
	corner(hintL, 6)

	local chatBar = Instance.new("Frame")
	chatBar.Size = UDim2.new(0, 320, 0, 36)
	chatBar.Position = UDim2.new(0, 16, 1, -52)
	chatBar.BackgroundColor3 = Color3.fromRGB(18, 21, 29)
	chatBar.BorderSizePixel = 0
	chatBar.Parent = gui
	corner(chatBar, 8)
	stroke(chatBar, palette.fieldBorder, 1)

	local chatBox = Instance.new("TextBox")
	chatBox.Size = UDim2.new(1, -52, 1, 0)
	chatBox.Position = UDim2.fromOffset(10, 0)
	chatBox.BackgroundTransparency = 1
	chatBox.Font = Enum.Font.GothamMedium
	chatBox.TextSize = 12
	chatBox.TextColor3 = palette.text
	chatBox.PlaceholderText = "Type message (press /)..."
	chatBox.PlaceholderColor3 = palette.subtle
	chatBox.TextXAlignment = Enum.TextXAlignment.Left
	chatBox.ClearTextOnFocus = false
	chatBox.Parent = chatBar
	hudChatBox = chatBox

	local sendBtn = Instance.new("TextButton")
	sendBtn.Size = UDim2.fromOffset(40, 26)
	sendBtn.Position = UDim2.new(1, -44, 0.5, -13)
	sendBtn.BackgroundColor3 = palette.accent
	sendBtn.BorderSizePixel = 0
	sendBtn.Font = Enum.Font.GothamBold
	sendBtn.TextSize = 11
	sendBtn.TextColor3 = palette.ink
	sendBtn.Text = "Send"
	sendBtn.Parent = chatBar
	corner(sendBtn, 6)

	local function doSend()
		local txt = chatBox.Text
		if #txt:gsub("%s+", "") > 0 then
			broadcastChatMessage(txt)
			chatBox.Text = ""
			isChatFocused = false
		end
	end

	sendBtn.MouseButton1Click:Connect(doSend)
	chatBox.FocusLost:Connect(function(enterPressed)
		isChatFocused = false
		if enterPressed then doSend() end
	end)
	chatBox.Focused:Connect(function()
		isChatFocused = true
	end)

	hudGui = gui
	teamTestActive = true

	toggleTeamTestBtn.Text = "⏹ Exit Team Test"
	toggleTeamTestBtn.TextColor3 = Color3.fromRGB(252, 165, 165)
	toggleTeamTestBtn.BackgroundColor3 = palette.dangerBg
	status("Team Test active! Run, jump and test your game with peers.")
end

local function toggleTeamTest()
	if teamTestActive then
		stopTeamTest()
	else
		startTeamTest()
	end
end

toggleTeamTestBtn.MouseButton1Click:Connect(toggleTeamTest)
teamTestToolbarBtn.Click:Connect(toggleTeamTest)

UserInputService.InputBegan:Connect(function(input, processed)
	if not teamTestActive then return end
	if input.UserInputType == Enum.UserInputType.MouseButton2 then
		isRmbDown = true
	end
	if not isChatFocused and input.KeyCode == Enum.KeyCode.Slash then
		if hudChatBox then
			task.defer(function() hudChatBox:CaptureFocus() end)
		end
	end
	if input.KeyCode == Enum.KeyCode.Escape then
		stopTeamTest()
	end
end)

UserInputService.InputEnded:Connect(function(input)
	if input.UserInputType == Enum.UserInputType.MouseButton2 then
		isRmbDown = false
	end
end)

UserInputService.InputChanged:Connect(function(input)
	if not teamTestActive then return end
	if isRmbDown and input.UserInputType == Enum.UserInputType.MouseMovement then
		camYaw = camYaw - input.Delta.X * 0.005
		camPitch = math.clamp(camPitch - input.Delta.Y * 0.005, -1.2, 1.2)
	end
	if input.UserInputType == Enum.UserInputType.MouseWheel then
		camDist = math.clamp(camDist - input.Position.Z * 1.5, 4, 32)
	end
end)

local function updateLocalTester(dt)
	if not teamTestActive or not localTesterChar or not localTesterChar.PrimaryPart then return end

	local isW = (not isChatFocused) and (UserInputService:IsKeyDown(Enum.KeyCode.W) or UserInputService:IsKeyDown(Enum.KeyCode.Up))
	local isS = (not isChatFocused) and (UserInputService:IsKeyDown(Enum.KeyCode.S) or UserInputService:IsKeyDown(Enum.KeyCode.Down))
	local isA = (not isChatFocused) and (UserInputService:IsKeyDown(Enum.KeyCode.A) or UserInputService:IsKeyDown(Enum.KeyCode.Left))
	local isD = (not isChatFocused) and (UserInputService:IsKeyDown(Enum.KeyCode.D) or UserInputService:IsKeyDown(Enum.KeyCode.Right))
	local isSpace = (not isChatFocused) and UserInputService:IsKeyDown(Enum.KeyCode.Space)
	local isShift = (not isChatFocused) and (UserInputService:IsKeyDown(Enum.KeyCode.LeftShift) or UserInputService:IsKeyDown(Enum.KeyCode.RightShift))

	local forward = Vector3.new(math.sin(camYaw), 0, -math.cos(camYaw))
	local right = Vector3.new(math.cos(camYaw), 0, math.sin(camYaw))
	local moveDir = Vector3.zero
	if isW then moveDir = moveDir + forward end
	if isS then moveDir = moveDir - forward end
	if isD then moveDir = moveDir + right end
	if isA then moveDir = moveDir - right end

	local isMoving = moveDir.Magnitude > 0.05
	if isMoving then moveDir = moveDir.Unit end

	localWalkSpeed = isShift and 26 or 16
	local deltaMove = moveDir * (localWalkSpeed * dt)

	local rayParams = RaycastParams.new()
	rayParams.FilterType = Enum.RaycastFilterType.Exclude
	rayParams.FilterDescendantsInstances = {getTeamTestFolder(), workspace.CurrentCamera}

	-- Wall collision & step-up
	if isMoving and deltaMove.Magnitude > 0.001 then
		local wallCheck = workspace:Raycast(localPos + Vector3.new(0, 0.5, 0), deltaMove.Unit * (deltaMove.Magnitude + 1.2), rayParams)
		if wallCheck then
			local stepCheck = workspace:Raycast(localPos + Vector3.new(0, 1.4, 0), deltaMove.Unit * (deltaMove.Magnitude + 1.2), rayParams)
			if not stepCheck then
				localPos = localPos + Vector3.new(0, 1.2, 0)
			else
				local n = wallCheck.Normal
				deltaMove = deltaMove - n * deltaMove:Dot(n)
			end
		end
	end

	localPos = localPos + deltaMove

	-- Floor & gravity check
	local floorRay = workspace:Raycast(localPos + Vector3.new(0, 1.2, 0), Vector3.new(0, -4.5, 0), rayParams)
	if floorRay then
		local floorY = floorRay.Position.Y + 2.7
		if localPos.Y <= floorY + 0.35 and localVertVel <= 0 then
			localPos = Vector3.new(localPos.X, floorY, localPos.Z)
			localVertVel = 0
			localGrounded = true
		else
			localVertVel = localVertVel - 90 * dt
			localPos = localPos + Vector3.new(0, localVertVel * dt, 0)
			localGrounded = false
		end
	else
		localVertVel = localVertVel - 90 * dt
		localPos = localPos + Vector3.new(0, localVertVel * dt, 0)
		localGrounded = false
	end

	-- Jump
	if isSpace and localGrounded then
		localVertVel = 38
		localGrounded = false
	end

	-- Void respawn
	if localPos.Y < -250 then
		localPos = getSpawnLocation()
		localVertVel = 0
		localGrounded = true
		status("Fell into the void. Respawned!")
	end

	-- Rotation
	if isMoving then
		local targetLook = Vector3.new(deltaMove.X, 0, deltaMove.Z).Unit
		localCharRot = localCharRot:Lerp(CFrame.lookAt(Vector3.zero, targetLook), 0.25)
	end

	local rootCF = CFrame.new(localPos) * (localCharRot - localCharRot.Position)
	localTesterChar:PivotTo(rootCF)

	-- State
	if not localGrounded then
		localState = (localVertVel > 0) and "Jumping" or "Freefall"
	elseif isMoving then
		localState = isShift and "Running" or "Walking"
		localStepTimer = localStepTimer + dt * (localWalkSpeed * 0.7)
	else
		localState = "Idle"
		localIdleTimer = localIdleTimer + dt
	end

	animateAvatar(localTesterChar, localState, localStepTimer, localIdleTimer)

	-- Chat bubble expiration
	if localCharBubbleFrame then
		localCharBubbleFrame.Visible = (os.clock() < myChatBubbleTime)
	end

	-- Camera
	local camFocus = localPos + Vector3.new(0, 1.8, 0)
	local camRot = CFrame.Angles(0, camYaw, 0) * CFrame.Angles(camPitch, 0, 0)
	local desiredCamPos = camFocus - (camRot.LookVector * camDist)
	local occ = workspace:Raycast(camFocus, desiredCamPos - camFocus, rayParams)
	if occ then
		desiredCamPos = occ.Position + occ.Normal * 0.4
	end
	workspace.CurrentCamera.CFrame = CFrame.lookAt(desiredCamPos, camFocus)
end

local function updateRemoteTester(peer, dt)
	local tt = peer.teamTest
	if not tt or not tt.active or not tt.pos then
		if remoteTesters[peer.id] then
			if remoteTesters[peer.id].model then remoteTesters[peer.id].model:Destroy() end
			remoteTesters[peer.id] = nil
		end
		return
	end

	local item = remoteTesters[peer.id]
	if not item then
		local folder = getTeamTestFolder()
		local tint = Color3.fromHSV(peer.hue or 0.6, 0.7, 1)
		local char, nickL, bFrame, bLabel = buildRobloxAvatar(peer.name, tt.userId or 0, tint)
		char.Parent = folder
		item = {
			model = char,
			label = nickL,
			bubbleFrame = bFrame,
			bubbleLabel = bLabel,
			pos = Vector3.new(table.unpack(tt.pos)),
			targetPos = Vector3.new(table.unpack(tt.pos)),
			rot = CFrame.lookAt(Vector3.zero, Vector3.new(table.unpack(tt.look or {0, 0, -1}))),
			targetRot = CFrame.lookAt(Vector3.zero, Vector3.new(table.unpack(tt.look or {0, 0, -1}))),
			state = tt.state or "Idle",
			stepTimer = 0,
			idleTimer = 0,
			lastChat = "",
			seen = os.clock(),
		}
		remoteTesters[peer.id] = item
	end

	item.seen = os.clock()
	item.targetPos = Vector3.new(table.unpack(tt.pos))
	if tt.look and #tt.look == 3 then
		local l = Vector3.new(table.unpack(tt.look))
		if l.Magnitude > 0.01 then
			item.targetRot = CFrame.lookAt(Vector3.zero, l)
		end
	end
	item.state = tt.state or "Idle"

	local blend = 1 - math.exp(-22 * math.min(dt, 0.1))
	item.pos = item.pos:Lerp(item.targetPos, blend)
	item.rot = item.rot:Lerp(item.targetRot, blend)

	item.model:PivotTo(CFrame.new(item.pos) * (item.rot - item.rot.Position))

	if item.state == "Running" or item.state == "Walking" then
		item.stepTimer = item.stepTimer + dt * 14
	else
		item.idleTimer = item.idleTimer + dt
	end

	animateAvatar(item.model, item.state, item.stepTimer, item.idleTimer)

	if tt.chat and tt.chat ~= "" and tt.chatTime and (os.clock() < tt.chatTime) then
		item.bubbleLabel.Text = tt.chat
		item.bubbleFrame.Visible = true
	else
		item.bubbleFrame.Visible = false
	end
end

-- 60 FPS RENDERSTEPPED INTERPOLATION & PEER PRESENCE / LIVE DRAG
-- ============================================================
do
	local alive = true
	local enabled = plugin:GetSetting("PTShowParticipants") ~= false
	local folder = nil
	local markers = {}
	local previousRoom = nil
	local previousBase = nil
	local sending = false

	local function clear()
		if folder then
			folder:Destroy()
			folder = nil
		end
		markers = {}
	end

	local function vector(v)
		return Vector3.new(v[1], v[2], v[3])
	end

	local function marker(peer)
		if not folder then
			folder = Instance.new("Folder")
			folder.Name = "PlaceTogetherPresence"
			folder.Archivable = false
			folder.Parent = game:GetService("CoreGui")
		end
		local group = Instance.new("Folder")
		group.Name = peer.id
		group.Parent = folder
		local tint = Color3.fromHSV(peer.hue or 0.55, 0.65, 1)

		local sphere = Instance.new("SphereHandleAdornment")
		sphere.Name = "Participant"
		sphere.Adornee = workspace.Terrain
		sphere.Radius = 1.4
		sphere.Color3 = tint
		sphere.Transparency = 0.15
		sphere.AlwaysOnTop = false
		sphere.Parent = group
		pcall(function() sphere.Shading = Enum.AdornShading.Shaded end)

		local direction = Instance.new("LineHandleAdornment")
		direction.Name = "Direction"
		direction.Adornee = workspace.Terrain
		direction.Color3 = tint
		direction.Thickness = 3
		direction.Parent = group

		local caption = Instance.new("BillboardGui")
		caption.Name = "Nickname"
		caption.Adornee = workspace.Terrain
		caption.Size = UDim2.fromOffset(180, 32)
		caption.AlwaysOnTop = true
		caption.MaxDistance = 2500
		caption.Parent = group

		local label = Instance.new("TextLabel")
		label.Size = UDim2.fromScale(1, 1)
		label.BackgroundTransparency = 1
		label.Font = Enum.Font.GothamBold
		label.TextSize = 13
		label.TextColor3 = tint
		label.TextStrokeColor3 = Color3.fromRGB(15, 15, 20)
		label.TextStrokeTransparency = 0.15
		label.Text = peer.name
		label.Parent = caption

		return {
			group = group,
			sphere = sphere,
			direction = direction,
			tint = tint,
			selection = {},
			boxes = {},
			caption = caption,
			label = label,
			position = vector(peer.position),
			target = vector(peer.position),
			look = vector(peer.look),
			targetLook = vector(peer.look),
			seen = os.clock(),
		}
	end

	local function receive(peers)
		local present = {}
		local names = {}
		for _, peer in ipairs(peers) do
			present[peer.id] = true
			table.insert(names, peer.name)
			if enabled then
				local item = markers[peer.id] or marker(peer)
				markers[peer.id] = item
				item.target = vector(peer.position)
				item.targetLook = vector(peer.look)
				item.label.Text = peer.name
				item.seen = os.clock()
				item.selection = {}
				for _, key in ipairs(peer.selected or {}) do
					item.selection[key] = true
				end
				for key, box in pairs(item.boxes) do
					if not item.selection[key] then
						box:Destroy()
						item.boxes[key] = nil
					end
				end
			end
			-- Apply live drag transforms from peer at 60 FPS!
			if smoothLerpEnabled and type(peer.transforms) == "table" then
				for key, comps in pairs(peer.transforms) do
					local obj = objects[key]
					if obj and type(comps) == "table" and #comps == 12 then
						local cf = CFrame.new(table.unpack(comps))
						if obj:IsA("Model") then
							queueSmoothTransform(key, obj, cf, true, false)
						elseif obj:IsA("BasePart") then
							queueSmoothTransform(key, obj, cf, false, false)
						end
					end
				end
			end
		end
		for id, item in pairs(markers) do
			if not present[id] then
				item.group:Destroy()
				markers[id] = nil
			end
		end
		participantsText.Text = #names > 0 and ("Peers online ("..#names.."): "..table.concat(names, ", ")) or "No other participants in room yet."

		-- Update Active Team Testers
		local testers = {}
		for _, peer in ipairs(peers) do
			if peer.teamTest and peer.teamTest.active then
				table.insert(testers, peer.name)
				updateRemoteTester(peer, 0.016)
			else
				if remoteTesters[peer.id] then
					if remoteTesters[peer.id].model then remoteTesters[peer.id].model:Destroy() end
					remoteTesters[peer.id] = nil
				end
			end
		end
		activeTestersList = testers
		local allTesters = {}
		if teamTestActive then table.insert(allTesters, selfNick.Text .. " (You)") end
		for _, tName in ipairs(testers) do table.insert(allTesters, tName) end

		ttActiveUsersLabel.Text = #allTesters > 0 and ("👥 Active testers: " .. table.concat(allTesters, ", ")) or "No active testers in room."

		-- Update Active Script Co-Authors
		local scriptingPeers = {}
		local inSameScript = false
		for _, peer in ipairs(peers) do
			if peer.activeScript and peer.activeScript.name then
				local sDesc = peer.name .. " in '" .. peer.activeScript.name .. "' (Line " .. tostring(peer.activeScript.line or 1) .. ")"
				table.insert(scriptingPeers, sDesc)
				if currentActiveScriptInfo and peer.activeScript.id == currentActiveScriptInfo.id then
					inSameScript = peer.name
				end
			end
		end

		if inSameScript then
			scActiveLabel.Text = "🟢 Live Co-authoring '" .. currentActiveScriptInfo.name .. "' with " .. inSameScript .. "!"
			scActiveLabel.TextColor3 = palette.green
		elseif #scriptingPeers > 0 then
			scActiveLabel.Text = "✏️ " .. table.concat(scriptingPeers, " · ")
			scActiveLabel.TextColor3 = palette.accent
		elseif currentActiveScriptInfo then
			scActiveLabel.Text = "You are editing '" .. currentActiveScriptInfo.name .. "' (Line " .. tostring(currentActiveScriptInfo.line or 1) .. ")"
			scActiveLabel.TextColor3 = palette.muted
		else
			scActiveLabel.Text = "Open any script in Studio to start co-editing."
			scActiveLabel.TextColor3 = palette.subtle
		end
		if hudActiveUsersLabel then
			hudActiveUsersLabel.Text = "👥 " .. table.concat(allTesters, ", ")
		end

		if teamTestActive then
			toggleTeamTestBtn.Text = "⏹ Exit Team Test"
			toggleTeamTestBtn.TextColor3 = Color3.fromRGB(252, 165, 165)
			toggleTeamTestBtn.BackgroundColor3 = palette.dangerBg
		elseif #testers > 0 then
			toggleTeamTestBtn.Text = "▶ Join Team Test (" .. testers[1] .. " is testing!)"
			toggleTeamTestBtn.TextColor3 = Color3.fromRGB(187, 247, 208)
			toggleTeamTestBtn.BackgroundColor3 = palette.greenBg
		else
			toggleTeamTestBtn.Text = "▶ Start Team Test"
			toggleTeamTestBtn.TextColor3 = palette.ink
			toggleTeamTestBtn.BackgroundColor3 = palette.accent
		end
	end

	local function cameraState()
		local camera = workspace.CurrentCamera
		if not camera then return nil end
		local position = camera.CFrame.Position
		local look = camera.CFrame.LookVector
		local selected = {}
		local transforms = {}
		local tCount = 0
		for _, obj in ipairs(Selection:Get()) do
			local key = ids[obj]
			if key and obj:IsDescendantOf(workspace) and (obj:IsA("BasePart") or obj:IsA("Model")) then
				table.insert(selected, key)
				if tCount < 16 then
					local ok, cf = pcall(function()
						return obj:IsA("Model") and obj:GetPivot() or obj.CFrame
					end)
					if ok and cf then
						transforms[key] = {cf:GetComponents()}
						tCount += 1
					end
				end
				if #selected >= 32 then break end
			end
		end
		local teamTestData = nil
		if teamTestActive and localTesterChar and localTesterChar.PrimaryPart then
			local p = localTesterChar.PrimaryPart.Position
			local lv = localTesterChar.PrimaryPart.CFrame.LookVector
			teamTestData = {
				active = true,
				pos = {p.X, p.Y, p.Z},
				look = {lv.X, lv.Y, lv.Z},
				state = localState,
				chat = myChatBubbleText,
				chatTime = myChatBubbleTime,
				userId = myUserId or 0,
			}
		else
			teamTestData = { active = false }
		end

		return {
			position = {position.X, position.Y, position.Z},
			look = {look.X, look.Y, look.Z},
			selected = selected,
			transforms = transforms,
			teamTest = teamTestData,
			activeScript = currentActiveScriptInfo,
		}
	end

	presenceToggle.Text = enabled and "Peer Cursors & Live Drag: On" or "Peer Cursors & Live Drag: Off"
	local toggleConnection = presenceToggle.MouseButton1Click:Connect(function()
		enabled = not enabled
		plugin:SetSetting("PTShowParticipants", enabled)
		presenceToggle.Text = enabled and "Peer Cursors & Live Drag: On" or "Peer Cursors & Live Drag: Off"
		if not enabled then clear() end
	end)

	local renderConnection = Run.RenderStepped:Connect(function(dt)
		if not active or Run:IsRunning() then
			if folder then clear() end
			smoothTargets = {}
			if teamTestActive then stopTeamTest() end
			return
		end

		if teamTestActive then
			updateLocalTester(dt)
		end

		-- 1. 60 FPS Smooth Object Transform Interpolation
		if smoothLerpEnabled and next(smoothTargets) then
			applyingRemote = true
			local objBlend = 1 - math.exp(-22 * math.min(dt, 0.1))
			local now = os.clock()
			for key, item in pairs(smoothTargets) do
				local obj = item.obj
				if not obj or not obj.Parent or isLocallyDragging(obj) then
					smoothTargets[key] = nil
				else
					local ok, curCF = pcall(function()
						return item.isModel and obj:GetPivot() or obj.CFrame
					end)
					if not ok or not curCF then
						smoothTargets[key] = nil
					else
						local dist = (curCF.Position - item.targetCF.Position).Magnitude
						if dist < 0.002 and curCF.Rotation:FuzzyEq(item.targetCF.Rotation, 0.0005) or (now - item.updatedAt > 0.5) then
							pcall(function()
								if item.isModel then obj:PivotTo(item.targetCF) else obj.CFrame = item.targetCF end
							end)
							smoothTargets[key] = nil
						else
							local nextCF = curCF:Lerp(item.targetCF, objBlend)
							pcall(function()
								if item.isModel then obj:PivotTo(nextCF) else obj.CFrame = nextCF end
							end)
						end
					end
				end
			end
			applyingRemote = false
		end

		-- 2. 60 FPS Peer Camera / Avatar Interpolation
		if not enabled then
			if folder then clear() end
			return
		end
		local blend = 1 - math.exp(-16 * math.min(dt, 0.1))
		for id, item in pairs(markers) do
			if os.clock() - item.seen > 12 then
				item.group:Destroy()
				markers[id] = nil
			else
				item.position = item.position:Lerp(item.target, blend)
				item.look = item.look:Lerp(item.targetLook, blend)
				item.sphere.CFrame = workspace.Terrain.CFrame:ToObjectSpace(CFrame.new(item.position))
				item.direction.Visible = item.look.Magnitude > 0.01
				if item.look.Magnitude > 0.01 then
					item.direction.CFrame = workspace.Terrain.CFrame:ToObjectSpace(CFrame.lookAt(item.position, item.position + item.look))
					item.direction.Length = 4
				end
				item.caption.StudsOffsetWorldSpace = item.position - workspace.Terrain.Position + Vector3.new(0, 2.5, 0)
				for key in pairs(item.selection) do
					local obj = objects[key]
					local box = item.boxes[key]
					if obj and obj:IsDescendantOf(workspace) and (obj:IsA("BasePart") or obj:IsA("Model")) then
						if not box then
							box = Instance.new("SelectionBox")
							box.Name = "SelectedObject"
							box.Color3 = item.tint
							box.SurfaceColor3 = item.tint
							box.SurfaceTransparency = 0.9
							box.LineThickness = 0.04
							box.Parent = item.group
							item.boxes[key] = box
						end
						box.Adornee = obj
					elseif box then
						box:Destroy()
						item.boxes[key] = nil
					end
				end
			end
		end
	end)

	-- Fast 0.15s (~6.6 Hz) Presence & Live Drag stream loop
	task.spawn(function()
		while alive do
			if active and loggedIn and not Run:IsRunning() then
				local currentRoom = room.Text
				local currentBase = base()
				if previousRoom ~= currentRoom or previousBase ~= currentBase then
					clear()
				end
				previousRoom = currentRoom
				previousBase = currentBase
				local payload = cameraState()
				if payload then
					sending = true
					local ok, peers = pcall(function()
						return api("/rooms/"..currentRoom.."/presence", "POST", payload)
					end)
					sending = false
					if alive and active and not Run:IsRunning() and currentRoom == room.Text and currentBase == base() then
						if ok then
							local rendered, reason = pcall(function() receive(peers) end)
							if not rendered then
								clear()
								participantsText.Text = "Peer cursors: "..tostring(reason)
							end
						else
							participantsText.Text = "Updating peer connection..."
						end
					end
				end
			else
				clear()
				participantsText.Text = "Participants will appear once connected."
				if previousRoom and not sending then
					local oldRoom = previousRoom
					local oldBase = previousBase
					previousRoom = nil
					previousBase = nil
					if oldBase == base() then
						pcall(function() api("/rooms/"..oldRoom.."/presence", "POST", {leave = true}) end)
					end
				end
			end
			task.wait(0.15)
		end
	end)

	plugin.Unloading:Connect(function()
		alive = false
		renderConnection:Disconnect()
		toggleConnection:Disconnect()
		clear()
	end)
end]]></ProtectedString>
